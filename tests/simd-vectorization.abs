// SIMD and Vectorization tests for numeric arrays (int32[], float[], double[])

void vectorAdd(int32[] a, int32[] b, int32[] result) {
    int32 len = a.length;
    int32 i = 0;
    while (i < len) {
        result[i] = a[i] + b[i];
        i += 1;
    }
}

void vectorScaleFloat(float[] data, float factor) {
    int32 len = data.length;
    int32 i = 0;
    while (i < len) {
        data[i] = data[i] * factor;
        i += 1;
    }
}

double dotProductDouble(double[] a, double[] b) {
    int32 len = a.length;
    double sum = 0.0;
    int32 i = 0;
    while (i < len) {
        sum += a[i] * b[i];
        i += 1;
    }
    return sum;
}

int32 main() {
    int32 size = 64;

    // 1. int32 vector addition
    int32[] a = new int32[size];
    int32[] b = new int32[size];
    int32[] res = new int32[size];

    int32 i = 0;
    while (i < size) {
        a[i] = i * 2;
        b[i] = i * 3;
        i += 1;
    }

    vectorAdd(a, b, res);

    i = 0;
    while (i < size) {
        assert(res[i] == i * 5, "vector add element match");
        i += 1;
    }

    // 2. float vector scaling
    float[] floats = new float[size];
    i = 0;
    while (i < size) {
        floats[i] = (i as float) * 1.5;
        i += 1;
    }

    vectorScaleFloat(floats, 2.0);

    i = 0;
    while (i < size) {
        float expected = (i as float) * 3.0;
        assert(floats[i] == expected, "float scale element match");
        i += 1;
    }

    // 3. double dot product
    double[] doublesA = new double[size];
    double[] doublesB = new double[size];
    i = 0;
    while (i < size) {
        doublesA[i] = 1.0;
        doublesB[i] = 2.5;
        i += 1;
    }

    double dot = dotProductDouble(doublesA, doublesB);
    assert(dot == (64.0 * 2.5), "double dot product match");

    println("simd-vectorization=ok");
    return 0;
}
