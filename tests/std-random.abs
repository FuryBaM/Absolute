import "../std/random.abs";

int32 main() {
    std.random.Rng* first = new std.random.Rng(42);
    std.random.Rng* second = new std.random.Rng(42);
    std.random.Rng* different = new std.random.Rng(43);
    std.random.Rng* sample = new std.random.Rng(100);
    std.random.Rng* golden = new std.random.Rng(42);

    uint64 firstValue = first.u64();
    assert(firstValue == second.u64(), "equal seeds must reproduce u64 values");
    assert(firstValue != different.u64(), "different seeds must change the sequence");
    assert(golden.i32() == 360188718, "seed 42 must preserve the xoshiro256** sequence");

    std.random.Rng* zeroA = new std.random.Rng(0);
    std.random.Rng* zeroB = new std.random.Rng(0);
    assert(zeroA.u64() == zeroB.u64(), "seed 0 is a seed");

    int32 iteration = 0;
    while (iteration < 256) {
        assert(first.u64() == second.u64(), "equal seeds must reproduce the full sequence");
        int32 ranged = sample.range(-20, 23);
        assert(ranged >= -20 && ranged < 23, "range must remain half-open");
        double real = sample.real();
        assert(real >= 0.0 && real < 1.0, "real must stay in [0, 1)");
        sample.i32();
        sample.boolean();
        iteration += 1;
    }

    bool invalidRangeRejected = false;
    try {
        sample.range(5, 5);
    }
    catch (Error* error) {
        invalidRangeRejected = true;
    }
    assert(invalidRangeRejected, "empty random ranges must be rejected");

    std.random.entropy();
    uint8[] randomBytes = new uint8[32];
    std.random.fill(randomBytes);
    bool anyNonZero = false;
    int32 byteIndex = 0;
    while (byteIndex < randomBytes.length) {
        if (randomBytes[byteIndex] != (0 as uint8)) { anyNonZero = true; }
        byteIndex = byteIndex + 1;
    }
    assert(anyNonZero, "system byte entropy must fill the destination");
    uint8[] emptyBytes = new uint8[0];
    std.random.fill(emptyBytes);

    std.random.Rng* system = std.random.create();
    system.u64();

    // A span wider than 2^31 used to overflow the wasm copy's signed
    // subtraction, so the interval it sampled was not the one it was asked for.
    std.random.Rng* wide = new std.random.Rng(7);
    int32 iterationWide = 0;
    while (iterationWide < 64) {
        int32 picked = wide.range(-2000000000, 2000000000);
        assert(picked >= -2000000000 && picked < 2000000000,
            "a wide range stays inside the range");
        iterationWide += 1;
    }

    println("std-random=ok");
    return 0;
}
