struct Pair {
    int32 left;
    int32 right;
}

struct OwnedBuffer {
    int32[] values;

    void initialize(int32 seed) {
        values = copy({seed, seed + 1, seed + 2});
    }

    int32 sum() {
        return values[0] + values[1] + values[2];
    }
}

class Node {
    public int32 value;

    public Node(int32 initial) {
        value = initial;
    }
}

Pair changedCopy(Pair value) {
    value.left += 100;
    return value;
}

void changePlace(ref Pair value) {
    value.left += 10;
}

int32 inspect(const Pair& value) {
    return value.left + value.right;
}

int32 borrowNode(Node* node) {
    return node.value;
}

void consumeNode(consume Node* node) {
    assert(node.value > 0, "consume managed owner is readable");
}

Node* forwardNode(consume Node* node) {
    return move(node);
}

T* forwardGeneric<T>(consume T* value) {
    return move(value);
}

void consumeArray(consume int32[] values) {
    assert(values[0] + values[2] == 4, "consume array receives storage");
}

void consumeBuffer(consume OwnedBuffer buffer) {
    assert(buffer.sum() == 33, "consume aggregate receives nested owner");
}

int32 main() {
    Pair original;
    original.left = 1;
    original.right = 2;
    Pair copied = changedCopy(original);
    assert(original.left == 1 && copied.left == 101,
        "value parameter copies instead of aliasing");

    changePlace(original);
    assert(original.left == 11, "ref aliases a writable place");
    assert(inspect(original) == 13, "const ref borrows an lvalue");
    assert(inspect(changedCopy(original)) == 113,
        "const ref extends a value temporary through the call");
    println("ownership-matrix:value-ref=ok");

    int32 scalar = 5;
    raw int32* address = &scalar;
    *address = 9;
    assert(scalar == 9, "address and dereference preserve place identity");
    println("ownership-matrix:raw=ok");

    Node* owner = new Node(21);
    Node* subscriber = owner;
    weak Node* observer = owner;
    assert(borrowNode(owner) == 21 && borrowNode(subscriber) == 21,
        "ordinary managed pointer parameters borrow owner and subscriber");
    consumeNode(move(owner));
    assert(!subscriber && !observer,
        "consume destroys transferred owner and expires sub and weak handles");
    println("ownership-matrix:managed-consume=ok");

    Node* returned = forwardNode(new Node(31));
    assert(returned.value == 31, "fresh owner can enter consume and move out");
    delete returned;
    println("ownership-matrix:managed-forward=ok");

    Node* genericOwner = new Node(41);
    Node* genericReturned = forwardGeneric<Node>(move(genericOwner));
    assert(genericReturned.value == 41,
        "generic consume T pointer preserves ownership");
    delete genericReturned;
    println("ownership-matrix:generic=ok");

    int32[] values = copy({1, 2, 3});
    consumeArray(move(values));
    println("ownership-matrix:array=ok");

    OwnedBuffer buffer;
    buffer.initialize(10);
    consumeBuffer(move(buffer));
    println("ownership-matrix:aggregate=ok");

    println("ownership-semantics-matrix=ok");
    return 0;
}
