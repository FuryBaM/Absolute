int32 releaseOnReturn(bool early) {
    keep int32* value = new int32(42);
    if (early) {
        delete value;
        return 1;
    }
    delete value;
    return 0;
}

int32 releaseInBranches(bool first) {
    keep int32* value = new int32(7);
    if (first) {
        delete value;
    }
    else {
        delete value;
    }
    return 0;
}

int32 releaseBeforeBreak(bool stop) {
    int32 iteration = 0;
    while (iteration < 2) {
        keep int32* value = new int32(iteration);
        delete value;
        if (stop) {
            break;
        }
        iteration = iteration + 1;
    }
    return iteration;
}

int32 main() {
    assert(releaseOnReturn(false) == 0, "keep return cleanup");
    assert(releaseInBranches(true) == 0, "keep branch cleanup");
    assert(releaseBeforeBreak(true) == 0, "keep break cleanup");
    println("keep-lifetime=ok");
    return 0;
}
