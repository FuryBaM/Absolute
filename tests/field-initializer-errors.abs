// What a class runs its field initializers in, a struct has not got: its
// storage is made by declaring it, and an element of `new S[n]` is zeroed with
// nothing to run at all. So the initializer is refused here, at its own line,
// rather than quietly dropped -- which is what used to happen everywhere.
struct Point {
    int64 x = 1;
    string tag = "here";
}

int32 main() {
    Point p;
    println(format("{} {}", p.x, p.tag));
    return 0;
}
