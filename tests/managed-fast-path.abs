int64 managedFastPath() {
    int64* value = new int64(1);
    int32 iteration = 0;
    while (iteration < 1000) {
        *value = (*value * 3 + iteration) & 2147483647;
        iteration += 1;
    }
    int64 result = *value;
    delete value;
    return result;
}

int64 checkedBorrowedDeref(int64* value) {
    return *value;
}

int32 main() {
    int64 fastResult = managedFastPath();
    int64* borrowedSource = new int64(42);
    assert(checkedBorrowedDeref(borrowedSource) == 42,
        "borrowed managed dereference remains generation checked");
    delete borrowedSource;
    println(format("managed-fast-path={}", fastResult));
    return 0;
}
