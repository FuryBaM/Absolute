struct Pair {
    int32 x;
    int32 y;

    Pair(int32 initialX, int32 initialY) {
        x = initialX;
        y = initialY;
    }

    int32 sum() {
        return x + y;
    }
}

struct Packet {
    int32[] values;
    raw Pair* link;
}

struct LargeValue {
    int64 first;
    int64 second;
    int64 third;
    int64 fourth;
}

struct LargeBox {
    LargeValue stored;

    LargeBox(LargeValue initial) {
        stored = initial;
        initial.first = -1;
    }

    LargeValue read() {
        return stored;
    }

    void replace(LargeValue next) {
        stored = next;
        next.second = -1;
    }
}

interface ILargeMapper {
    LargeValue map(LargeValue value);
}

class LargeMapper : ILargeMapper {
    public LargeValue map(LargeValue value) {
        value.first += 32;
        return value;
    }
}

Pair makePair(int32 x, int32 y) {
    Pair result;
    result.x = x;
    result.y = y;
    return result;
}

int32 sumPair(Pair value) {
    return value.x + value.y;
}

LargeValue makeLarge(int64 seed) {
    LargeValue result;
    result.first = seed;
    result.second = seed + 1;
    result.third = seed + 2;
    result.fourth = seed + 3;
    return result;
}

int64 mutateLargeCopy(LargeValue value) {
    value.first = 1000;
    return value.first + value.second + value.third + value.fourth;
}

int32 main() {
    Pair value = makePair(20, 22);
    Pair copy = value;
    copy.x = 40;
    assert(value.x == 20, "struct assignment must copy by value");
    assert(sumPair(value) == 42, "struct parameter and return value");

    raw Pair* rawValue = new raw Pair(19, 23);
    assert(rawValue.sum() == 42, "raw struct pointer member access");

    Pair* managedValue = new Pair(18, 24);
    assert(managedValue.x + managedValue.y == 42, "managed struct pointer member access");

    Packet packet;
    packet.values = copy({40, 41, 42});
    packet.link = rawValue;
    assert(packet.values[2] == 42, "array descriptor stored in struct field");
    assert(packet.link.y == 23, "raw pointer stored in struct field");

    LargeValue large = makeLarge(10);
    assert(mutateLargeCopy(large) == 1036, "large struct parameter uses a private copy");
    assert(large.first == 10, "large struct argument must not alias its source");

    raw LargeBox* largeBox = new raw LargeBox(large);
    LargeValue fromBox = largeBox.read();
    assert(fromBox.first == 10 && fromBox.fourth == 13,
        "large struct constructor parameter and method return");
    fromBox.first = 99;
    LargeValue unchangedBox = largeBox.read();
    assert(unchangedBox.first == 10, "large struct method return must be independent");
    LargeValue replacement = makeLarge(20);
    largeBox.replace(replacement);
    assert(replacement.second == 21, "large struct method parameter must not alias its source");
    LargeValue replacedBox = largeBox.read();
    assert(replacedBox.fourth == 23, "large struct method parameter copied into field");

    raw ILargeMapper* mapper = new raw LargeMapper();
    LargeValue mapped = mapper.map(large);
    assert(mapped.first == 42 && large.first == 10,
        "large struct ABI through interface dispatch");

    delete rawValue;
    delete largeBox;
    delete mapper;
    println("structs=ok");
    return 0;
}
