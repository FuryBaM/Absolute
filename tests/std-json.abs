import "../std/json.abs";

int32 main() {
    string sample = "{\"name\":\"Absolute\",\"version\":2,\"active\":true,\"tags\":[\"fast\",\"compiled\"]}";
    std.json.JsonValue* root = std.json.parse(sample);
    assert(root != null, "json.parse failed");
    assert(root.isObject() == true, "root is object");
    assert(root.hasProp("name") == true, "hasProp name");
    assert(root.getStringOr("name", "") == "Absolute", "typed string getter");
    assert(root.getIntOr("version", 0) == 2, "typed int getter");
    assert(root.getBoolOr("active", false), "typed bool getter");
    assert(root.getStringOr("missing", "fallback") == "fallback", "typed getter fallback");

    std.json.JsonValue* nameProp = root.getProp("name");
    assert(nameProp != null, "getProp name null");
    assert(nameProp.asString() == "Absolute", "name value match");

    std.json.JsonValue* verProp = root.getProp("version");
    assert(verProp != null, "getProp version null");
    assert(verProp.asInt() == 2, "version value match");

    std.json.JsonValue* tagsProp = root.getProp("tags");
    assert(tagsProp != null, "getProp tags null");
    assert(tagsProp.isArray() == true, "tags is array");
    assert(tagsProp.size() == 2, "tags size match");

    std.json.JsonValue* tag0 = tagsProp.getAt(0);
    assert(tag0 != null, "tag0 null");
    assert(tag0.asString() == "fast", "tag0 value match");

    root.dispose();

    std.json.JsonValue* obj = std.json.createObject();
    obj.setNumber("score", 100.0);
    obj.setString("status", "ok");
    std.json.JsonValue* details = std.json.createString("owned by object");
    obj.setProp("details", details);

    string jsonStr = obj.stringify();
    assert(jsonStr == "{\"details\":\"owned by object\",\"score\":100,\"status\":\"ok\"}", "stringify match");
    obj.dispose();

    std.json.JsonValue* array = std.json.createArray();
    array.addNumber(42.0);
    array.addString("answer");
    array.addBool(true);
    array.addNull();
    std.json.JsonValue* nested = std.json.createString("nested");
    array.add(nested);
    assert(array.stringify() == "[42,\"answer\",true,null,\"nested\"]", "array helpers and ownership transfer");

    println("std-json=ok");
    return 0;
}
