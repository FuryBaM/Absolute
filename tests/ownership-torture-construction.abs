// P4 ownership torture: partially constructed objects.
//
// A constructor that throws leaves an object whose earlier fields were already
// initialized. Those fields still hold resources, and nothing else in the
// program has a name for them, so releasing them is the constructor's job.
// The same applies when a base constructor throws after the derived class has
// begun, and when a throw interrupts a scope that already owns resources.
//
// Live resources are counted through a raw int32 the caller owns, so a leak is
// an assertion failure rather than something only a sanitizer would notice.

struct Counted {
    raw int32* live;

    void destroy() {
        if (live != null) {
            *live = *live - 1;
            live = null;
        }
    }
}

Counted acquire(raw int32* live) {
    Counted held;
    held.live = live;
    *live = *live + 1;
    return move(held);
}

class ThrowsAfterFirstField {
    public Counted first;
    public Counted second;

    public ThrowsAfterFirstField(raw int32* live) {
        first = acquire(live);
        throw new Error("constructor fails after one field");
    }
}

class ThrowsAfterBothFields {
    public Counted first;
    public Counted second;

    public ThrowsAfterBothFields(raw int32* live) {
        first = acquire(live);
        second = acquire(live);
        throw new Error("constructor fails after both fields");
    }
}

class HoldingBase {
    public Counted held;

    public HoldingBase(raw int32* live) {
        held = acquire(live);
    }
}

class ThrowsAfterBase : HoldingBase {
    public Counted own;

    public ThrowsAfterBase(raw int32* live) {
        base(live);
        own = acquire(live);
        throw new Error("derived constructor fails after base completed");
    }
}

class ThrowingBase {
    public Counted held;

    public ThrowingBase(raw int32* live) {
        held = acquire(live);
        throw new Error("base constructor fails");
    }
}

class DerivedOfThrowingBase : ThrowingBase {
    public Counted own;

    public DerivedOfThrowingBase(raw int32* live) {
        base(live);
        own = acquire(live);
    }
}

int32 releasesFieldsInitializedBeforeThrow() {
    int32 live = 0;
    raw int32* place = &live;
    try {
        ThrowsAfterFirstField* built = new ThrowsAfterFirstField(place);
        assert(false, "constructor must not complete");
    }
    catch (Error* failure) {
        assert(failure, "constructor failure is observable");
    }
    return live;
}

int32 releasesEveryFieldInitializedBeforeThrow() {
    int32 live = 0;
    raw int32* place = &live;
    try {
        ThrowsAfterBothFields* built = new ThrowsAfterBothFields(place);
        assert(false, "constructor must not complete");
    }
    catch (Error* failure) {
        assert(failure, "constructor failure is observable");
    }
    return live;
}

int32 releasesBaseWhenDerivedThrows() {
    int32 live = 0;
    raw int32* place = &live;
    try {
        ThrowsAfterBase* built = new ThrowsAfterBase(place);
        assert(false, "derived constructor must not complete");
    }
    catch (Error* failure) {
        assert(failure, "derived failure is observable");
    }
    return live;
}

int32 releasesWhenBaseItselfThrows() {
    int32 live = 0;
    raw int32* place = &live;
    try {
        DerivedOfThrowingBase* built = new DerivedOfThrowingBase(place);
        assert(false, "construction must not complete when the base throws");
    }
    catch (Error* failure) {
        assert(failure, "base failure is observable");
    }
    return live;
}

// A throw crossing a scope that already owns resources must still unwind it.
int32 releasesScopeOwnersOnThrow() {
    int32 live = 0;
    raw int32* place = &live;
    try {
        Counted outer = acquire(place);
        assert(live == 1, "scope owns one resource");
        {
            Counted inner = acquire(place);
            assert(live == 2, "nested scope owns a second resource");
            throw new Error("throw crossing two live scopes");
        }
    }
    catch (Error* failure) {
        assert(failure, "scope failure is observable");
    }
    return live;
}

// A class whose own destroy() hook counts its calls. A constructor that throws
// must not run it: the object never reached the state the hook assumes. The
// hook is deliberately not idempotent, so a second call is visible.
class HookCounted {
    public raw int32* hookRuns;
    public Counted held;

    public HookCounted(raw int32* live, raw int32* runs) {
        hookRuns = runs;
        held = acquire(live);
        throw new Error("constructor fails after acquiring a field");
    }

    public void destroy() {
        if (hookRuns != null) {
            *hookRuns = *hookRuns + 1;
        }
    }
}

class HookedBase {
    public raw int32* hookRuns;
    public Counted held;

    public HookedBase(raw int32* live, raw int32* runs) {
        hookRuns = runs;
        held = acquire(live);
    }

    public void destroy() {
        if (hookRuns != null) {
            *hookRuns = *hookRuns + 1;
        }
    }
}

// The base completes, then the derived constructor throws. The base's field must
// be released exactly once, and the inherited hook must not run at all.
class ThrowsOverHookedBase : HookedBase {
    public Counted own;

    public ThrowsOverHookedBase(raw int32* live, raw int32* runs) {
        base(live, runs);
        own = acquire(live);
        throw new Error("derived fails over a hooked base");
    }
}

// A hooked base that throws while a derived constructor is running. The base
// releases its own field on its own path; the derived frame must not repeat it.
class ThrowingHookedBase {
    public raw int32* hookRuns;
    public Counted held;

    public ThrowingHookedBase(raw int32* live, raw int32* runs) {
        hookRuns = runs;
        held = acquire(live);
        throw new Error("hooked base fails");
    }

    public void destroy() {
        if (hookRuns != null) {
            *hookRuns = *hookRuns + 1;
        }
    }
}

class DerivedOverThrowingHookedBase : ThrowingHookedBase {
    public Counted own;

    public DerivedOverThrowingHookedBase(raw int32* live, raw int32* runs) {
        base(live, runs);
        own = acquire(live);
    }
}

int32 hookRunsWhenConstructorThrows() {
    int32 live = 0;
    int32 runs = 0;
    raw int32* livePlace = &live;
    raw int32* runsPlace = &runs;
    try {
        HookCounted* built = new HookCounted(livePlace, runsPlace);
        assert(false, "constructor must not complete");
    }
    catch (Error* failure) {
        assert(failure, "failure is observable");
    }
    assert(live == 0, "the acquired field is released");
    return runs;
}

int32 hookRunsWhenDerivedThrowsOverBase() {
    int32 live = 0;
    int32 runs = 0;
    raw int32* livePlace = &live;
    raw int32* runsPlace = &runs;
    try {
        ThrowsOverHookedBase* built = new ThrowsOverHookedBase(livePlace, runsPlace);
        assert(false, "derived constructor must not complete");
    }
    catch (Error* failure) {
        assert(failure, "failure is observable");
    }
    assert(live == 0, "base and derived fields are both released");
    return runs;
}

int32 hookRunsWhenHookedBaseThrows() {
    int32 live = 0;
    int32 runs = 0;
    raw int32* livePlace = &live;
    raw int32* runsPlace = &runs;
    try {
        DerivedOverThrowingHookedBase* built =
            new DerivedOverThrowingHookedBase(livePlace, runsPlace);
        assert(false, "construction must not complete");
    }
    catch (Error* failure) {
        assert(failure, "failure is observable");
    }
    // Released exactly once: a second release would drive the count below zero.
    assert(live == 0, "the base field is released exactly once");
    return runs;
}

int32 main() {
    assert(releasesFieldsInitializedBeforeThrow() == 0,
        "a field initialized before the throw is released");
    assert(releasesEveryFieldInitializedBeforeThrow() == 0,
        "every field initialized before the throw is released");
    assert(releasesBaseWhenDerivedThrows() == 0,
        "a completed base is released when the derived constructor throws");
    assert(releasesWhenBaseItselfThrows() == 0,
        "a throwing base releases what it had already acquired");
    assert(releasesScopeOwnersOnThrow() == 0,
        "unwinding releases owners of every scope it crosses");

    assert(hookRunsWhenConstructorThrows() == 0,
        "a failed constructor does not run the type's own destroy() hook");
    assert(hookRunsWhenDerivedThrowsOverBase() == 0,
        "a failed derived constructor does not run the inherited destroy() hook");
    assert(hookRunsWhenHookedBaseThrows() == 0,
        "a failing base does not have its destroy() hook run, once or twice");

    println("ownership-torture-construction=ok");
    return 0;
}
