// A getter is a call, and what a call returns it hands over -- and what it
// hands over depends on which accessor it is.
//
// A callable that returns `T*` returns an owner -- the analyzer refuses any
// other kind with E_MANAGED_RETURN_REQUIRES_OWNER, and it refuses it for a
// property's getter the same as for a method. But the value a property access
// produced said it created no owner, so the name that received it was a
// subscriber: `delete` on it was refused as E_DELETE_SUBSCRIBER, nothing
// released it at the end of its scope, and the runtime's own leak check
// printed "memory leak detected for handle N" at exit.
//
// An *indexer* is not the same kind of call, and this is where that is said.
// An indexer is a projection onto a cell the object keeps -- `c[i]` names
// storage that already exists -- so its getter borrows and its setter takes.
// `T this[...]` reads as `sub T` and is written as `T`, which is why a
// container can hand out an element without giving it up, and why an indexer
// written as a factory is refused rather than leaked. The negative half is in
// tests/indexer-borrow-projection-errors.abs.
//
// A borrow still reads as a borrow: `sub T*` and `weak T*` say so in the type,
// and a getter that hands one back is unchanged by this.

class Node {
    public int32 value;
    public Node(int32 initial) { value = initial; }
}

class Source {
    private Node* kept;
    private Node*[] cells;
    private int32 seed;

    public Source(int32 initial) {
        seed = initial;
        kept = new Node(initial);
        cells = new Node*[5];
        int32 offset = 0;
        while (offset < 5) {
            cells[offset] = new Node(initial + offset);
            offset = offset + 1;
        }
    }

    // A property's getter produces an owner, which is the only thing a `Node*`
    // return is allowed to be.
    public Node* fresh { get { return new Node(seed); } }
    public Node* freshMethod() { return new Node(seed); }

    // An indexer's getter projects onto a cell this object keeps. It is
    // written `Node*` -- there is one place, and the setter is handed the
    // element -- and it reads as `sub Node*`, because reading a cell does not
    // give it up.
    public Node* this[int32 offset] {
        get { return cells[offset]; }
        set { cells[offset] = move(value); }
    }

    // And each of these hands back what this object holds, which is what the
    // qualifier says.
    public sub Node* borrowed { get { return kept; } }
    public weak Node* watched { get { return kept; } }

    // A property read from inside the class, by its bare name.
    public int32 doubled {
        get {
            Node* own = fresh;
            const int32 result = own.value * 2;
            delete own;
            return result;
        }
    }
}

int32 main() {
    Source* source = new Source(7);

    // A property's owner is deletable, which is what says the name owns it.
    Node* fromProperty = source.fresh;
    assert(fromProperty.value == 7, "the property built one");
    delete fromProperty;

    Node* fromMethod = source.freshMethod();
    assert(fromMethod.value == 7, "and so did the method");
    delete fromMethod;

    // An indexer's is not: it names a cell the source still owns, so the name
    // that receives it is a borrow and the source is what releases it.
    sub Node* fromIndexer = source[3];
    assert(fromIndexer.value == 10, "the indexer projected onto one");

    // The setter takes, which is the other half of the same type. The element
    // it replaces is released by the slot it was written into.
    source[3] = new Node(99);
    assert(source[3].value == 99, "the setter took it");
    source[3] = new Node(10);

    // A borrow is still a borrow: it names what the source holds, and the
    // source is what releases it.
    sub Node* borrowed = source.borrowed;
    assert(borrowed.value == 7, "a sub property names the object's own");
    weak Node* watched = source.watched;
    assert(watched != null, "and a weak one is still live while the owner is");

    // The bare name inside the class reaches the same getter.
    assert(source.doubled == 14, "a property read by its own name");

    // Enough rounds that an owner kept per read is a heap that grows, and
    // enough that a borrow released per read is a use-after-free. The
    // runtime's leak check reports every handle it still holds at exit, so a
    // missed release is loud rather than quiet -- and a release too many is
    // louder.
    int32 total = 0;
    int32 round = 0;
    while (round < 1500) {
        Node* one = source.fresh;
        sub Node* two = source[round % 5];
        total = total + one.value + two.value;
        delete one;
        total = total + source.doubled;
        round = round + 1;
    }
    assert(total == 45000, "every round counted");

    delete source;
    println("accessor-owner-transfer=ok");
    return 0;
}
