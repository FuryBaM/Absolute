// The other half of tests/main-signatures.abs: a `main` whose return type is
// wider than the status it becomes. The unhandled-exception path used to
// return a fixed-width 1 from it, which is invalid IR against `int64` for the
// same reason it is against `void`.
//
// What it returns normally still has to work, and 0 here is a success status
// like any other.

int64 folded(int64 value) {
    if (value < 0) { throw new Error("negative"); }
    return value * 2;
}

int64 main() {
    int64 total = 0;
    try {
        total = folded(21);
        total = total + folded(-1);
    } catch (Error* e) {
        total = total + 1;
    }
    assert(total == 43, "the first call counted and the second was caught");
    println("main-signatures-wide=ok");
    return 0;
}
