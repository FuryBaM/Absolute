import "../std/process.abs";

int32 main() {
    assert(std.process.pid() > 0, "PID must be positive");
    assert(std.process.executablePath() != "", "executable path must not be empty");
    assert(std.process.hostname() != "", "hostname must not be empty");

    assert(std.process.argsCount() >= 1, "args count must be at least 1");
    assert(std.process.argAt(0) != "", "argAt(0) must not be empty");

    string output = std.process.runCapture("echo hello_process");
    assert(output != "", "captured output should not be empty");

    println("std-process=ok");
    return 0;
}
