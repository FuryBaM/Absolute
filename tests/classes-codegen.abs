class Counter {
    public int32 value;

    public int32 read() {
        return value;
    }
}

class Node {
    public virtual int64 evaluate(int64 input) {
        return input;
    }
}

class AddNode : Node {
    public int64 bias;

    public AddNode(int64 initialBias) {
        bias = initialBias;
    }

    public override int64 evaluate(int64 input) {
        return input + bias;
    }
}

int64 managedClassScope() {
    AddNode* node = new AddNode(2);
    return node.evaluate(40);
}

int32 main() {
    Counter counter;
    counter.value = 40;
    assert(counter.read() == 40, "value class member access");

    raw Node* node = new raw AddNode(2);
    int64 result = node.evaluate(40);
    assert(result == 42, "virtual dispatch through base pointer");
    delete node;

    Node* managedNode = new AddNode(3);
    Node* subscriber = managedNode;
    int64 managedResult = managedNode.evaluate(39);
    assert(managedResult == 42, "virtual dispatch through managed base pointer");
    assert(subscriber.evaluate(39) == 42, "managed class subscriber access");
    delete managedNode;
    assert(!subscriber, "managed class subscriber must expire with its owner");

    assert(managedClassScope() == 42, "managed class owner must clean up at scope exit");
    println(format("classes={}", result));
    return 0;
}
