// An array an expression made and nobody kept releases what its elements hold.
//
// Such an array was registered as a bare buffer and released with `free`,
// which let go of the storage and of nothing in it. Every shape that reads
// something out of an array without keeping the array leaked one count per
// element that has one:
//
//   makeArray().length          a field of it
//   makeArray()[0]              an element of it
//   foreach (x in makeArray())  a loop over it
//   copy(makeArray())           a copy of it, which had just counted every
//                               element into the new array
//
// It is registered as the value it is now, so the walk that releases it is the
// one the type already describes -- the same walk a scope-owned array gets.
// `copy` releases its temporary source the same way, elements first.
//
// What a named array does was already right and is here to stay right: the
// scope walks it, and nothing releases a view into someone else's storage.
//
// Run under AddressSanitizer with the leak check on.

import "../std/string.abs";

string[] three(int32 seed) {
    string[] made = new string[3];
    made[0] = format("a{}", seed);
    made[1] = format("b{}", seed);
    made[2] = format("c{}", seed);
    return made;
}

int32 total(string[] values) { return values.length; }

int32 main() {
    int32 round = 0;
    while (round < 2000) {
        // A field of an array nobody keeps.
        assert(three(round).length == 3, "a field of a temporary array");

        // An element of one.
        assert(three(round)[1] != "", "an element of a temporary array");

        // A loop over one, and one that leaves early.
        foreach (string text in three(round)) {
            assert(text != "", "a loop over a temporary array");
        }
        foreach (string text in three(round)) {
            assert(text != "", "and one that stops");
            break;
        }

        // A copy of one: the copy counts every element, so the source has to
        // give its own counts back.
        string[] copied = copy(three(round));
        assert(copied[2] != "", "a copy of a temporary array");

        // Borrowed by a call, which is the shape that was already right.
        assert(total(three(round)) == 3, "a temporary array as an argument");

        round = round + 1;
    }

    // A named array is the scope's, and a copy of it leaves it alone.
    string[] kept = three(1);
    int32 copies = 0;
    while (copies < 2000) {
        string[] copied = copy(kept);
        assert(copied[0] == kept[0], "a copy names the same bytes");
        copies = copies + 1;
    }
    assert(kept[0] != "", "and the original still holds them");

    // A slot is a place the array releases, so it gives back what it held
    // before taking another. Overwriting one that already held something left
    // the old value with nobody at all -- and every write below is to a slot
    // that is already full.
    string[] slots = new string[2];
    slots[0] = "first";
    int32 written = 0;
    while (written < 2000) {
        slots[0] = format("w{}", written);
        unsafeArraySet(slots, 1, format("u{}", written));
        assert(slots[0] != "", "the slot holds the last one written");
        assert(slots[1] != "", "however it was written");
        written = written + 1;
    }

    // The two being the same bytes is the case the order has to survive.
    int32 same = 0;
    while (same < 2000) {
        slots[0] = slots[0];
        assert(slots[0] != "", "a slot assigned to itself keeps its bytes");
        same = same + 1;
    }

    // A slice is a view of part of an allocation, and releasing one releases
    // all of it. Through the view it released only what the view named, so the
    // elements outside the slice were left holding what they held while the
    // storage under them was freed.
    int32 sliced = 0;
    while (sliced < 2000) {
        // Kept in a name: the name owns the allocation and describes part.
        string[] head = three(sliced)[0:2];
        assert(head[0] != "", "a slice keeps what it names");

        // From the middle, so neither end is the allocation's.
        string[] middle = three(sliced)[1:3];
        assert(middle[0] != "", "wherever the slice starts");

        // Copied out of one: `copy` releases its temporary source, all of it.
        string[] copied = copy(three(sliced)[0:2]);
        assert(copied[1] != "", "a copy of a slice of a temporary");

        // Read through without keeping anything.
        assert(three(sliced)[0:2].length == 2, "a field of one");
        foreach (string text in three(sliced)[1:3]) {
            assert(text != "", "a loop over one");
        }
        sliced = sliced + 1;
    }

    // A slice of a *named* array is a view into storage the name still owns,
    // and nothing here releases it twice.
    string[] owner = three(7);
    int32 views = 0;
    while (views < 2000) {
        string[] view = owner[0:2];
        assert(view[0] == owner[0], "a view names what the owner holds");
        views = views + 1;
    }
    assert(owner[2] != "", "and the owner still holds all of it");

    println("temporary-array-elements=ok");
    return 0;
}
