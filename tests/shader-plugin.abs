@shader.stage(Vertex)
shader Vertex {
    input position;
    input normal;
    output clipPosition;
}

@shader.stage(Compute)
shader Compute {
    storage float values;
    workgroup 8, 1, 1;
    kernel {
        values[id.x] = values[id.x] + 1.0;
    }
}

int32 main() {
    assert(Shader.generatedComputeHlsl() != "", "generated compute HLSL");
    assert(Shader.generatedComputeGlsl() != "", "generated compute GLSL");
    println("shader-plugin=ok");
    return 0;
}
