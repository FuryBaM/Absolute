import "../std/collections/deque.abs";

int32 main() {
    std.collections.Deque<int32>* deque = new std.collections.Deque<int32>(4);
    assert(deque.isEmpty, "new deque is empty");

    deque.pushBack(1);
    deque.pushBack(2);
    deque.pushBack(3);
    deque.pushBack(4);
    assert(deque.popFront() == 1, "pop first front");
    assert(deque.popFront() == 2, "pop second front");

    deque.pushBack(5);
    deque.pushBack(6);
    deque.pushFront(0);
    assert(deque.count == 5, "deque count after wrap and growth");
    assert(deque.front == 0 && deque.back == 6, "deque ends");
    assert(deque[1] == 3 && deque[4] == 6, "logical indexing across ring");

    deque[2] = 40;
    int32[] values = deque.toArray();
    assert(values.length == 5, "deque snapshot size");
    assert(values[0] == 0 && values[1] == 3 && values[2] == 40 &&
        values[3] == 5 && values[4] == 6, "deque snapshot order");
    assert(deque.contains(40) && !deque.contains(4), "deque contains");

    std.collections.DequeIterator<int32>* iterator = deque.iterate();
    int32 sum = 0;
    while (iterator.next()) {
        sum = sum + iterator.value;
    }
    assert(sum == 54, "deque iterator snapshot");

    std.collections.Queue<string>* queue = new std.collections.Queue<string>(2);
    queue.enqueue("first");
    queue.enqueue("second");
    queue.enqueue("third");
    assert(queue.front == "first", "queue front");
    assert(queue.toArray()[2] == "third", "queue snapshot uses dequeue order");
    assert(queue.dequeue() == "first", "queue FIFO first");
    assert(queue.dequeue() == "second", "queue FIFO second");
    assert(queue.dequeue() == "third" && queue.isEmpty, "queue FIFO third");

    std.collections.Stack<int32>* stack = new std.collections.Stack<int32>(2);
    stack.push(10);
    stack.push(20);
    stack.push(30);
    assert(stack.top == 30, "stack top");
    assert(stack.toArray()[0] == 30, "stack snapshot uses pop order");
    assert(stack.pop() == 30, "stack LIFO first");
    assert(stack.pop() == 20, "stack LIFO second");
    assert(stack.pop() == 10 && stack.isEmpty, "stack LIFO third");

    bool emptyRejected = false;
    try {
        deque.clear();
        deque.popBack();
    }
    catch (Error* error) {
        emptyRejected = true;
    }
    assert(emptyRejected, "empty deque operation throws");

    println("std-deque=ok");
    return 0;
}
