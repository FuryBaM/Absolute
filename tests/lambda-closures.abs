// A lambda may capture the enclosing function's parameters, not just its
// locals. The parameter's symbol has to survive into code generation for the
// capture to find the storage it refers to.
int32 captureFunctionParameter(int32 amount) {
    func<int32, int32> add = fn(int32 value) => value + amount;
    return add(1);
}

int32 captureTwoParameters(int32 left, int32 right) {
    func<int32> total = fn() => left + right;
    return total();
}

func<int32, int32> escapeWithParameter(int32 amount) {
    return fn(int32 value) => value + amount;
}

class ParameterCapture {
    public int32 scale(int32 factor) {
        func<int32, int32> multiply = fn(int32 value) => value * factor;
        return multiply(6);
    }
}

int32 main() {
    int32 offset = 2;
    func<int32, int32> addOffset = fn(int32 value) => value + offset;
    assert(addOffset(40) == 42, "lambda value capture");
    func<int32, int32> copied = addOffset;
    offset = 100;
    addOffset = fn(int32 value) => value + 1;
    assert(copied(40) == 42, "closure copy keeps its environment alive");
    assert(addOffset(41) == 42, "closure reassignment releases the old owner");

    func<int32, int32> absolute = fn(int32 value) -> int32 {
        if (value < 0) {
            return -value;
        }
        return value;
    };
    assert(absolute(-42) == 42, "lambda statement body");

    func<int32, int32> inferredBlock = fn(int32 value) {
        return value + 1;
    };
    assert(inferredBlock(41) == 42, "contextual lambda return type");

    auto explicitBlock = fn(int32 value) -> int32 {
        return value + 2;
    };
    assert(explicitBlock(40) == 42, "explicit block lambda return type");

    func<void, int32> checkValue = fn(int32 value) -> void {
        assert(value == 42, "void statement lambda");
    };
    checkValue(42);

    func<func<int32, int32>, int32> makeAdder = fn(int32 captured) =>
        fn(int32 value) => value + captured;
    func<int32, int32> addTwo = makeAdder(2);
    assert(addTwo(40) == 42, "nested escaping closure");

    assert(captureFunctionParameter(41) == 42,
        "lambda captures an enclosing function parameter");
    assert(captureTwoParameters(20, 22) == 42,
        "lambda captures several enclosing parameters");
    ParameterCapture* receiver = new ParameterCapture();
    assert(receiver.scale(7) == 42, "lambda captures a method parameter");
    func<int32, int32> escaped = escapeWithParameter(5);
    assert(escaped(37) == 42,
        "closure over a parameter outlives the call that made it");

    println("lambda-closures=ok");
    return 0;
}
