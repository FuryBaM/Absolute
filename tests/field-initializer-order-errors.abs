// Initializers run in declaration order, so a field declared further down
// still holds its zero when an earlier one's initializer would read it:
// `first = second + 1` is 1, not 3. That is a wrong answer with no diagnostic,
// which is the shape this whole file exists to prevent, so the reference is
// refused instead. A field cannot read its own value either -- its initializer
// is what gives it one.
class Late {
    private int64 first = second + 1;
    private int64 second = 2;
    private int64 itself = itself + 1;
    public int64 a() { return first; }
}

int32 main() {
    Late* late = new Late();
    println(format("{}", late.a()));
    return 0;
}
