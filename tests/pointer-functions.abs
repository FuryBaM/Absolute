int32* makeValue(int32 initial) {
    return new int32(initial);
}

int32* transferValue(int32 initial) {
    int32* owned = new int32(initial);
    return owned;
}

int32* noValue() {
    return null;
}

raw int32* rawIdentity(raw int32* value) {
    return value;
}

int32 main() {
    int32* first = makeValue(40);
    int32* second = transferValue(42);
    int32* subscriber = second;
    int32* empty = noValue();
    assert(*first == 40, "managed return from allocation");
    assert(*second == 42, "managed return transfers local ownership");
    assert(second != null, "live managed pointer compares unequal to null");
    assert(empty == null, "managed function may return null");
    delete second;
    assert(subscriber == null, "stale managed subscriber compares equal to null");

    raw int32* rawValue = new raw int32(7);
    raw int32* same = rawIdentity(rawValue + 0);
    assert(same == rawValue, "raw pointer offset");
    assert(same - rawValue == 0, "raw pointer difference");
    assert(rawValue != null, "raw pointer null comparison");
    delete rawValue;
    assert(rawValue == null, "deleted raw pointer is null");

    delete first;
    println("pointer-functions=ok");
    return 0;
}
