// `copy` duplicates a buffer, not what the bytes in it refer to.
//
// A shallow copy of an array whose elements own something produces two arrays
// holding the same handles. There is no reading of that which is right: under
// any rule about who releases them, one of the two arrays is wrong. Refused
// rather than deep-copied -- what a deep copy of an owner should mean is not a
// decision this builtin gets to make.
//
// The wider question of whether an array owns its elements at all is open and
// recorded in docs/known-defects.md; this refusal is the part that holds
// either way.

class Cell {
    public int32 value;
    public Cell(int32 initial) { value = initial; }
}

struct Boxed {
    public Cell* held;
}

Cell*[] escaping() {
    Cell*[] source = { new Cell(1), new Cell(2) };
    return copy(source);
}

int32 main() {
    Cell*[] owners = { new Cell(1) };
    Cell*[] shallow = copy(owners);

    Boxed[] boxes = new Boxed[2];
    Boxed[] copiedBoxes = copy(boxes);

    // Elements that own nothing are unaffected: this is the ordinary copy the
    // rest of the language relies on, and it must keep working.
    int32[] numbers = { 1, 2, 3 };
    int32[] duplicate = copy(numbers);
    println(duplicate[0]);
    return 0;
}
