import "../std/task.abs";
import "../std/concurrent.abs";

async void completeChild(int64 counterAddress, int64 amount) {
    std.task.delay(2);
    raw void* counter = counterAddress as raw void*;
    absolute_atomic_fetch_add(counter, amount);
}

async void cancellationChild(int64 counterAddress) {
    while (!std.task.cancelled()) {
        std.task.delay(1);
    }
    raw void* counter = counterAddress as raw void*;
    absolute_atomic_fetch_add(counter, 1);
}

async int32 main() {
    raw void* completed = absolute_atomic_create(0);
    int64 completedAddress = completed as int64;
    {
        auto taskSet = new std.task.TaskGroup();
        task<void> first = spawn completeChild(completedAddress, 20);
        task<void> second = spawn completeChild(completedAddress, 22);
        assert(taskSet.add(first), "first child accepted");
        assert(taskSet.add(second), "second child accepted");
        assert(taskSet.count() == 2, "group owns both children");
        taskSet.join();
        assert(taskSet.count() == 0, "joined group is empty");
    }
    assert(absolute_atomic_load(completed) == 42, "joined children completed");
    absolute_atomic_destroy(completed);

    raw void* cancelled = absolute_atomic_create(0);
    int64 cancelledAddress = cancelled as int64;
    {
        auto cancelledGroup = new std.task.TaskGroup();
        task<void> child = spawn cancellationChild(cancelledAddress);
        assert(cancelledGroup.add(child), "cancellable child accepted");
    }
    assert(absolute_atomic_load(cancelled) == 1, "cancellation reached child");
    absolute_atomic_destroy(cancelled);

    println("task-group=ok");
    return 0;
}
