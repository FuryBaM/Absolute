import "../std/net.abs";

int32 main() {
    string resolved = std.net.resolve("127.0.0.1");
    assert(resolved == "127.0.0.1", "resolve 127.0.0.1 failed");

    std.net.UdpSocket* server = std.net.bindUdp("127.0.0.1", 0);
    defer server.close();

    int32 serverPort = server.localPort();
    assert(serverPort > 0, "udp server localPort invalid");

    std.net.UdpSocket* client = std.net.bindUdp("127.0.0.1", 0);
    defer client.close();

    int32 sent = client.sendTo("127.0.0.1", serverPort, "Hello UDP!");
    assert(sent > 0, "udp sendTo failed");

    string recvd = server.receiveFrom(1024);
    assert(recvd == "Hello UDP!", "udp receiveFrom match failed");

    println("std-net-udp=ok");
    return 0;
}
