// In-memory virtual filesystem and portable std.fs paths on wasm.
import "../std/fs.abs";

export "C" int32 wasm_fs_roundtrip() {
    string joined = std.fs.join("/tmp/assets", "../hello.txt");
    if (joined != "/tmp/hello.txt") {
        return 1;
    }
    if (std.fs.normalize("tmp\\assets\\..\\hello.txt") != "tmp/hello.txt" ||
        std.fs.join("/ignored", "/tmp/hello.txt") != "/tmp/hello.txt") {
        return 7;
    }
    if (std.fs.parent(joined) != "/tmp" ||
        std.fs.fileName(joined) != "hello.txt" ||
        std.fs.stem(joined) != "hello" ||
        std.fs.extensionOf(joined) != ".txt") {
        return 2;
    }

    std.fs.Path* path = std.fs.path("/tmp");
    path.push("nested");
    path.push("..");
    path.push("hello.txt");
    path.writeText("hello-wasm");
    if (!path.exists() || path.readText() != "hello-wasm") {
        return 3;
    }
    if (path.size() != 10 || !path.absolute) {
        return 4;
    }
    path.remove();
    if (path.exists()) {
        return 6;
    }
    return 0;
}

int32 main() {
    int32 code = wasm_fs_roundtrip();
    assert(code == 0, "wasm fs roundtrip");
    println("wasm-fs=ok");
    return 0;
}
