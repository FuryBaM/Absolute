interface IEvaluable {
    int64 evaluate(int64 input);
}

interface IAdvanced : IEvaluable {
    int64 twice(int64 input);
}

interface INamed {
    int64 id();
}

interface IScored {
    int64 id();
}

interface IDefaultMath {
    int64 doubled(int64 input) {
        return input * 2;
    }
}

interface ISelfDispatch {
    int64 seed();

    // A default body may call the rest of the contract. The call has to reach
    // the concrete implementation through the vtable, not the declaration.
    int64 doubled() {
        return seed() * 2;
    }

    int64 quadrupled() {
        return doubled() * 2;
    }
}

class SelfDispatchLow : ISelfDispatch {
    public virtual int64 seed() {
        return 5;
    }
}

class SelfDispatchHigh : ISelfDispatch {
    public virtual int64 seed() {
        return 11;
    }
}

class SelfDispatchOverride : ISelfDispatch {
    public virtual int64 seed() {
        return 1;
    }

    public virtual int64 doubled() {
        return 100;
    }
}

interface IDefaultLeft : IDefaultMath {
}

interface IDefaultRight : IDefaultMath {
}

interface IDefaultDiamond : IDefaultLeft, IDefaultRight {
}

interface IFirstChoice {
    int64 choice() {
        return 1;
    }
}

interface ISecondChoice {
    int64 choice() {
        return 2;
    }
}

interface ICombinedChoice : IFirstChoice, ISecondChoice {
}

namespace ContractSpace {
    interface IValue {
        int32 value() {
            return 42;
        }
    }

    class Value : IValue {
    }
}

class BaseNode {
    public virtual int64 evaluate(int64 input) {
        return input;
    }
}

class UsesInheritedDefault : IDefaultDiamond {
}

class OverridesDefault : IDefaultMath {
    public int64 doubled(int64 input) {
        return input * 3;
    }
}

class ResolvesDefaultConflict : ICombinedChoice {
    public int64 choice() {
        return 42;
    }
}

class AddNode : BaseNode, IAdvanced, INamed, IScored {
    public int64 bias;

    public AddNode(int64 initialBias) {
        bias = initialBias;
    }

    public override int64 evaluate(int64 input) {
        return input + bias;
    }

    public int64 twice(int64 input) {
        return (input + bias) * 2;
    }

    public int64 id() {
        return 42;
    }
}

int64 runRaw(raw IEvaluable* value, int64 input) {
    return value.evaluate(input);
}

int64 runManaged(IEvaluable* value, int64 input) {
    return value.evaluate(input);
}

int64 managedInterfaceScope() {
    IEvaluable* value = new AddNode(2);
    return value.evaluate(40);
}

int32 main() {
    raw UsesInheritedDefault* defaultConcrete = new raw UsesInheritedDefault();
    raw IDefaultMath* defaultContract = defaultConcrete;
    assert(defaultConcrete.doubled(21) == 42, "default method through concrete type");
    assert(defaultContract.doubled(21) == 42, "default method through interface");
    delete defaultConcrete;

    raw IDefaultMath* overridden = new raw OverridesDefault();
    assert(overridden.doubled(14) == 42, "class implementation overrides interface default");
    delete overridden;

    raw ResolvesDefaultConflict* resolved = new raw ResolvesDefaultConflict();
    raw ICombinedChoice* combinedChoice = resolved;
    raw IFirstChoice* firstChoice = combinedChoice;
    raw ISecondChoice* secondChoice = combinedChoice;
    assert(combinedChoice.choice() == 42 && firstChoice.choice() == 42 &&
        secondChoice.choice() == 42,
        "class method resolves inherited defaults in every interface slot");
    delete resolved;

    raw IAdvanced* unsafe = new raw AddNode(2);
    assert(runRaw(unsafe, 40) == 42, "raw interface dispatch");
    assert(unsafe.twice(19) == 42, "inherited raw interface dispatch");
    delete unsafe;

    AddNode* owner = new AddNode(3);
    IAdvanced* advanced = owner;
    IEvaluable* base = advanced;
    INamed* named = owner;
    IScored* scored = owner;
    assert(runManaged(base, 39) == 42, "managed interface dispatch");
    assert(advanced.twice(18) == 42, "managed child interface dispatch");
    assert(named.id() == 42 && scored.id() == 42,
        "one implementation may satisfy multiple interface slots");
    delete owner;
    assert(!advanced && !base && !named && !scored,
        "interface subscribers expire with the managed owner");
    assert(managedInterfaceScope() == 42,
        "managed interface owner cleans up at scope exit");

    ContractSpace.Value* namespacedOwner = new ContractSpace.Value();
    ContractSpace.IValue* namespacedContract = namespacedOwner;
    assert(namespacedContract.value() == 42, "namespaced interface dispatch");

    ISelfDispatch* selfLow = new SelfDispatchLow();
    ISelfDispatch* selfHigh = new SelfDispatchHigh();
    assert(selfLow.doubled() == 10 && selfHigh.doubled() == 22,
        "interface default body dispatches to the concrete implementation");
    assert(selfLow.quadrupled() == 20 && selfHigh.quadrupled() == 44,
        "interface default body reaches another default body");

    ISelfDispatch* selfOverride = new SelfDispatchOverride();
    assert(selfOverride.quadrupled() == 200,
        "a class override wins over the default a default body calls");

    println("interfaces=ok");
    return 0;
}
