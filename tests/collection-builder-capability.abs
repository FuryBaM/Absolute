import "../std/collections/vector.abs";
import "../std/collections/map.abs";
import "../std/collections/set.abs";

int32 main() {
    println("start");
    Vector<int32>* vec = new Vector<int32>();
    vec.push(10);
    vec.push(20);

    VectorBuilder<int32>* vecB = vec.builder();
    vecB.add(30);
    vecB.setAt(0, 99);

    assert(vec.count == 2, "original vector count remains 2 during builder execution");
    assert(vec[0] == 10, "original vector element 0 remains 10");

    Vector<int32>* publishedVec = vecB.finish();
    assert(publishedVec.count == 3, "published vector has 3 elements");
    assert(publishedVec[0] == 99, "published vector element 0 is 99");
    assert(publishedVec[2] == 30, "published vector element 2 is 30");

    println("VectorBuilder finish ok");

    Map<int32, int32>* map = new Map<int32, int32>();
    map.put(1, 100);

    MapBuilder<int32, int32>* mapB = map.builder();
    mapB.put(2, 200);

    assert(map.count == 1, "original map count remains 1");

    Map<int32, int32>* publishedMap = mapB.finish();
    assert(publishedMap.count == 2, "published map count is 2");
    assert(publishedMap[2] == 200, "published map key 2 is 200");

    println("MapBuilder finish ok");

    Set<int32>* collectionSet = new Set<int32>();
    collectionSet.add(5);

    SetBuilder<int32>* setB = collectionSet.builder();
    setB.add(15);

    assert(collectionSet.count == 1, "original set count remains 1");

    Set<int32>* publishedSet = setB.finish();
    assert(publishedSet.count == 2, "published set count is 2");
    assert(publishedSet.contains(15), "published set contains 15");

    println("SetBuilder finish ok");

    int32[] rawExport = vec.unsafeCopyRaw();
    assert(rawExport[0] == 10, "rawExport element 0 is 10");
    assert(rawExport[1] == 20, "rawExport element 1 is 20");

    println("unsafeCopyRaw ok");

    delete publishedSet;
    delete setB;
    delete collectionSet;
    delete publishedMap;
    delete mapB;
    delete map;
    delete publishedVec;
    delete vecB;
    delete vec;

    println("collection-builder=ok");
    return 0;
}
