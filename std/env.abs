// std.env - Environment variables and launch arguments

import "string.abs";
import "process.abs";

extern "C" string absolute_env_get(string name);
extern "C" int32 absolute_env_set(string name, string value);
extern "C" int32 absolute_env_remove(string name);
extern "C" int32 absolute_env_has(string name);
extern "C" string absolute_env_error();

namespace std.env {
    string error() {
        return absolute_env_error();
    }

    bool has(string name) {
        return absolute_env_has(name) != 0;
    }

    string getVar(string name) {
        if (!has(name)) {
            throw new Error(format("environment variable '{}' not found", name));
        }
        return absolute_env_get(name);
    }

    string getOrDefault(string name, string defaultValue) {
        if (!has(name)) {
            return defaultValue;
        }
        return absolute_env_get(name);
    }

    void setVar(string name, string value) {
        if (absolute_env_set(name, value) == 0) {
            throw new Error(format("failed to set environment variable '{}': {}", name, error()));
        }
    }

    void removeVar(string name) {
        if (absolute_env_remove(name) == 0) {
            throw new Error(format("failed to remove environment variable '{}': {}", name, error()));
        }
    }

    // The executable path is omitted. Index 0 is the first launch argument.
    int32 argsCount() {
        int32 nativeCount = std.process.argsCount();
        return nativeCount > 0 ? nativeCount - 1 : 0;
    }

    string argAt(int32 index) {
        if (index < 0 || index >= argsCount()) {
            throw new Error(format("launch argument index out of bounds: {}", index));
        }
        return std.process.argAt(index + 1);
    }

    bool hasArg(string value) {
        int32 i = 0;
        while (i < argsCount()) {
            if (argAt(i) == value) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    bool flag(string name) {
        string option = name;
        if (!std.text.startsWith(option, "-")) {
            option = format("--{}", option);
        }
        return hasArg(option);
    }

    bool hasParameter(string name) {
        string option = name;
        if (!std.text.startsWith(option, "-")) {
            option = format("--{}", option);
        }
        string inlinePrefix = format("{}=", option);
        int32 i = 0;
        while (i < argsCount()) {
            string current = argAt(i);
            if (current == option) {
                return i + 1 < argsCount();
            }
            if (std.text.startsWith(current, inlinePrefix)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    string parameter(string name) {
        string option = name;
        if (!std.text.startsWith(option, "-")) {
            option = format("--{}", option);
        }
        string inlinePrefix = format("{}=", option);
        int32 prefixLength = std.text.codePointCount(inlinePrefix);
        int32 i = 0;
        while (i < argsCount()) {
            string current = argAt(i);
            if (current == option) {
                if (i + 1 >= argsCount()) {
                    throw new Error(format("launch parameter '{}' requires a value", option));
                }
                return argAt(i + 1);
            }
            if (std.text.startsWith(current, inlinePrefix)) {
                return std.text.substring(
                    current,
                    prefixLength,
                    std.text.codePointCount(current) - prefixLength);
            }
            i = i + 1;
        }
        throw new Error(format("launch parameter '{}' not found", option));
    }

    string parameterOrDefault(string name, string defaultValue) {
        if (!hasParameter(name)) {
            return defaultValue;
        }
        return parameter(name);
    }
}
