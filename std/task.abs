extern "C" int32 absolute_task_current_core();
extern "C" int32 absolute_task_current_priority();
extern "C" string absolute_task_current_role();
extern "C" bool absolute_task_current_role_is(string role);
extern "C" int32 absolute_scheduler_worker_count();
extern "C" bool absolute_scheduler_affinity_supported();
extern "C" bool absolute_scheduler_core_available(int32 core);
extern "C" bool absolute_task_current_affinity_applied();
extern "C" void absolute_task_delay(int32 ms);
extern "C" bool absolute_task_current_cancelled();
extern "C" bool absolute_task_current_set_deadline_after(int32 milliseconds);
extern "C" int32 absolute_task_current_deadline_remaining();
extern "C" raw void* absolute_cancellation_token_create();
extern "C" void absolute_cancellation_token_cancel(raw void* token);
extern "C" bool absolute_cancellation_token_is_cancelled(raw void* token);
extern "C" void absolute_cancellation_token_destroy(raw void* token);
extern "C" raw void* absolute_task_group_create();
extern "C" int32 absolute_task_group_count(raw void* groupHandle);
extern "C" void absolute_task_group_cancel(raw void* groupHandle);
extern "C" void absolute_task_group_join(raw void* groupHandle);
extern "C" void absolute_task_group_cancel_and_join(raw void* groupHandle);
extern "C" void absolute_task_group_destroy(raw void* groupHandle);

namespace std.task {
    int32 core() {
        return absolute_task_current_core();
    }

    int32 priority() {
        return absolute_task_current_priority();
    }

    string role() {
        return absolute_task_current_role();
    }

    bool hasRole(string expected) {
        return absolute_task_current_role_is(expected);
    }

    int32 workerCount() {
        return absolute_scheduler_worker_count();
    }

    bool affinitySupported() {
        return absolute_scheduler_affinity_supported();
    }

    bool coreAvailable(int32 core) {
        return absolute_scheduler_core_available(core);
    }

    bool affinityApplied() {
        return absolute_task_current_affinity_applied();
    }

    void delay(int32 ms) {
        absolute_task_delay(ms);
    }

    void sleep(int32 ms) {
        absolute_task_delay(ms);
    }

    bool cancelled() {
        return absolute_task_current_cancelled();
    }

    void setDeadlineAfter(int32 milliseconds) {
        if (!absolute_task_current_set_deadline_after(milliseconds)) {
            throw new Error(
                "task deadline requires a running task and non-negative milliseconds");
        }
    }

    int32 deadlineRemaining() {
        return absolute_task_current_deadline_remaining();
    }

    class CancellationToken {
        private raw void* handle;

        public CancellationToken() {
            handle = absolute_cancellation_token_create();
        }

        public void cancel() {
            absolute_cancellation_token_cancel(handle);
        }

        public bool isCancelled() {
            return absolute_cancellation_token_is_cancelled(handle);
        }

        public void destroy() {
            if (handle != null) {
                absolute_cancellation_token_destroy(handle);
                handle = null;
            }
        }

        public void dispose() { destroy(); }
    }

    class TaskGroup {
        private raw void* handle;

        public TaskGroup() {
            handle = absolute_task_group_create();
        }

        public bool add(task<void> child) {
            return taskGroupAdd(handle, child);
        }

        public int32 count() {
            return absolute_task_group_count(handle);
        }

        public void cancel() {
            absolute_task_group_cancel(handle);
        }

        public void join() {
            absolute_task_group_join(handle);
        }

        public void cancelAndJoin() {
            absolute_task_group_cancel_and_join(handle);
        }

        public void destroy() {
            if (handle != null) {
                absolute_task_group_destroy(handle);
                handle = null;
            }
        }

        public void dispose() { destroy(); }
    }
}
