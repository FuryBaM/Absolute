import "string.abs";
import "net.abs";
import "uri.abs";

namespace std.http {
    class HttpRequest {
        public string method;
        public string url;
        public string headers;
        public string body;

        public HttpRequest(string methodVal, string urlVal, string bodyVal) {
            method = methodVal;
            url = urlVal;
            headers = "";
            body = bodyVal;
        }
    }

    class HttpResponse {
        public int32 statusCode;
        public string statusText;
        public string headers;
        public string body;

        public HttpResponse() {
            statusCode = 200;
            statusText = "OK";
            headers = "";
            body = "";
        }

        public bool isSuccess() {
            return statusCode >= 200 && statusCode < 300;
        }
    }

    HttpResponse* fetch(string urlStr) {
        std.uri.Uri* uri = std.uri.parse(urlStr);
        defer delete uri;

        std.net.TcpSocket* socket = null;
        int32 attempts = 0;
        while (socket == null && attempts < 10) {
            try {
                socket = std.net.connect(uri.host, uri.port);
            } catch (Error* e) {
                attempts = attempts + 1;
            }
        }
        if (socket == null) {
            throw new Error(format("HTTP fetch failed to connect to {}:{}", uri.host, uri.port));
        }
        defer socket.close();

        string reqStr = format("GET {} HTTP/1.1\r\nHost: {}\r\nConnection: close\r\n\r\n", uri.path, uri.host);
        socket.send(reqStr);

        string responseRaw = socket.receive(65536);
        HttpResponse* response = new HttpResponse();

        int32 headerEnd = std.text.indexOf(responseRaw, "\r\n\r\n");
        if (headerEnd >= 0) {
            response.body = std.text.substring(responseRaw, headerEnd + 4, std.text.codePointCount(responseRaw) - (headerEnd + 4));
            string headerPart = std.text.substring(responseRaw, 0, headerEnd);
            response.headers = headerPart;

            int32 firstLineEnd = std.text.indexOf(headerPart, "\r\n");
            if (firstLineEnd >= 0) {
                string statusLine = std.text.substring(headerPart, 0, firstLineEnd);
                if (std.text.contains(statusLine, "200")) { response.statusCode = 200; response.statusText = "OK"; }
                if (std.text.contains(statusLine, "404")) { response.statusCode = 404; response.statusText = "Not Found"; }
                if (std.text.contains(statusLine, "500")) { response.statusCode = 500; response.statusText = "Internal Server Error"; }
            }
        } else {
            response.body = responseRaw;
        }

        return response;
    }

    HttpResponse* post(string urlStr, string bodyText, string contentType) {
        std.uri.Uri* uri = std.uri.parse(urlStr);
        defer delete uri;

        std.net.TcpSocket* socket = null;
        int32 attempts = 0;
        while (socket == null && attempts < 10) {
            try {
                socket = std.net.connect(uri.host, uri.port);
            } catch (Error* e) {
                attempts = attempts + 1;
            }
        }
        if (socket == null) {
            throw new Error(format("HTTP post failed to connect to {}:{}", uri.host, uri.port));
        }
        defer socket.close();

        int32 bodyLen = std.text.codePointCount(bodyText);
        string reqStr = format("POST {} HTTP/1.1\r\nHost: {}\r\nContent-Type: {}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", uri.path, uri.host, contentType, bodyLen, bodyText);
        socket.send(reqStr);

        string responseRaw = socket.receive(65536);
        HttpResponse* response = new HttpResponse();

        int32 headerEnd = std.text.indexOf(responseRaw, "\r\n\r\n");
        if (headerEnd >= 0) {
            response.body = std.text.substring(responseRaw, headerEnd + 4, std.text.codePointCount(responseRaw) - (headerEnd + 4));
            response.headers = std.text.substring(responseRaw, 0, headerEnd);
            response.statusCode = 200;
        } else {
            response.body = responseRaw;
        }

        return response;
    }

    class HttpContext {
        public raw HttpRequest* request;
        public raw uint8* socketHandle;

        public HttpContext(raw HttpRequest* req, raw uint8* nativeSock) {
            request = req;
            socketHandle = nativeSock;
        }

        public void send(int32 statusCode, string contentType, string bodyText) {
            if (socketHandle != null) {
                string statusMsg = "OK";
                if (statusCode == 404) { statusMsg = "Not Found"; }
                if (statusCode == 500) { statusMsg = "Internal Error"; }

                int32 bodyLen = std.text.codePointCount(bodyText);
                string respStr = format("HTTP/1.1 {} {}\r\nContent-Type: {}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", statusCode, statusMsg, contentType, bodyLen, bodyText);
                absolute_net_tcp_send(socketHandle, respStr);
                absolute_net_tcp_close(socketHandle);
                socketHandle = null;
            }
        }

        public void dispose() {
            if (request != null) {
                delete request;
                request = null;
            }
            if (socketHandle != null) {
                absolute_net_tcp_close(socketHandle);
                socketHandle = null;
            }
        }
    }

    class HttpServer {
        private std.net.TcpListener* listener;

        public HttpServer() {
            listener = null;
        }

        public bool listen(string host, int32 port) {
            listener = std.net.listen(host, port, 16);
            return listener != null;
        }

        public int32 port() {
            if (listener != null) {
                return listener.port();
            }
            return 0;
        }

        public HttpContext* accept() {
            if (listener == null) { return null; }
            raw uint8* nativeSock = absolute_net_tcp_accept(listener.getHandle());
            if (nativeSock == null) { return null; }

            string rawReq = absolute_net_tcp_receive(nativeSock, 16384);

            string reqMethod = "GET";
            string reqUrl = "/";
            string reqBody = "";

            int32 space1 = std.text.indexOf(rawReq, " ");
            if (space1 >= 0) {
                reqMethod = std.text.substring(rawReq, 0, space1);
                string rest = std.text.substring(rawReq, space1 + 1, std.text.codePointCount(rawReq) - (space1 + 1));
                int32 space2 = std.text.indexOf(rest, " ");
                if (space2 >= 0) {
                    reqUrl = std.text.substring(rest, 0, space2);
                }
            }

            int32 bodyStart = std.text.indexOf(rawReq, "\r\n\r\n");
            if (bodyStart >= 0) {
                reqBody = std.text.substring(rawReq, bodyStart + 4, std.text.codePointCount(rawReq) - (bodyStart + 4));
            }

            return new HttpContext(new raw HttpRequest(reqMethod, reqUrl, reqBody), nativeSock);
        }

        public void close() {
            if (listener != null) {
                listener.close();
                listener = null;
            }
        }
    }
}
