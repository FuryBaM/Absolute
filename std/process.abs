// std.process - Process management, execution, arguments, and process info

extern "C" int32 absolute_process_pid();
extern "C" void absolute_process_exit(int32 code);
extern "C" void absolute_process_abort();
extern "C" string absolute_process_executable_path();
extern "C" int32 absolute_process_run(string command);
extern "C" string absolute_process_run_capture(string command);
extern "C" int32 absolute_process_args_count();
extern "C" string absolute_process_arg_at(int32 index);
extern "C" string absolute_process_hostname();
extern "C" int32 absolute_process_set_cwd(string path);
extern "C" string absolute_process_error();

namespace std.process {
    string error() {
        return absolute_process_error();
    }

    int32 pid() {
        return absolute_process_pid();
    }

    void exit(int32 code) {
        absolute_process_exit(code);
    }

    void abort() {
        absolute_process_abort();
    }

    string executablePath() {
        return absolute_process_executable_path();
    }

    string hostname() {
        return absolute_process_hostname();
    }

    int32 argsCount() {
        return absolute_process_args_count();
    }

    string argAt(int32 index) {
        if (index < 0 || index >= argsCount()) {
            throw new Error(format("argument index out of bounds: {}", index));
        }
        return absolute_process_arg_at(index);
    }

    string[] args() {
        int32 count = argsCount();
        string[] result = new string[count];
        int32 index = 0;
        while (index < count) {
            result[index] = argAt(index);
            index = index + 1;
        }
        return copy(result);
    }

    int32 run(string command) {
        return absolute_process_run(command);
    }

    string runCapture(string command) {
        return absolute_process_run_capture(command);
    }

    void setCwd(string path) {
        if (absolute_process_set_cwd(path) == 0) {
            throw new Error(format("failed to change directory to '{}': {}", path, error()));
        }
    }
}
