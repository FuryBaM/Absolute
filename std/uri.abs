import "string.abs";
import "encoding.abs";

namespace std.uri {
    int32 defaultPortFor(string scheme) {
        if (scheme == "https") { return 443; }
        if (scheme == "ws") { return 80; }
        if (scheme == "wss") { return 443; }
        return 80;
    }

    class Uri {
        public string scheme;
        public string host;
        public int32 port;
        public string path;
        public string query;
        public string fragment;

        public Uri() {
            scheme = "http";
            host = "";
            port = 80;
            path = "/";
            query = "";
            fragment = "";
        }

        public void destroy() {}
        public void dispose() { destroy(); }

        public string toString() {
            string result = format("{}://{}", scheme, host);
            // A port is only implied by the scheme that implies it: dropping
            // 443 from an http URL, or 80 from an https one, moves the URL.
            if (port != defaultPortFor(scheme)) {
                result = format("{}:{}", result, port);
            }
            result = format("{}{}", result, path);
            if (query != "") {
                result = format("{}?{}", result, query);
            }
            if (fragment != "") {
                result = format("{}#{}", result, fragment);
            }
            return result;
        }
    }

    Uri* parse(string rawUrl) {
        Uri* uri = new Uri();
        string remaining = rawUrl;

        int32 schemeEnd = std.text.indexOf(remaining, "://");
        if (schemeEnd >= 0) {
            uri.scheme = std.text.substring(remaining, 0, schemeEnd);
            remaining = std.text.substring(remaining, schemeEnd + 3, std.text.codePointCount(remaining) - (schemeEnd + 3));
            uri.port = defaultPortFor(uri.scheme);
        }

        int32 fragStart = std.text.indexOf(remaining, "#");
        if (fragStart >= 0) {
            uri.fragment = std.text.substring(remaining, fragStart + 1, std.text.codePointCount(remaining) - (fragStart + 1));
            remaining = std.text.substring(remaining, 0, fragStart);
        }

        int32 queryStart = std.text.indexOf(remaining, "?");
        if (queryStart >= 0) {
            uri.query = std.text.substring(remaining, queryStart + 1, std.text.codePointCount(remaining) - (queryStart + 1));
            remaining = std.text.substring(remaining, 0, queryStart);
        }

        int32 pathStart = std.text.indexOf(remaining, "/");
        string authority = remaining;
        if (pathStart >= 0) {
            uri.path = std.text.substring(remaining, pathStart, std.text.codePointCount(remaining) - pathStart);
            authority = std.text.substring(remaining, 0, pathStart);
        } else {
            uri.path = "/";
        }

        // Userinfo is part of the authority and ends at the last "@"; without
        // dropping it, "user:pass@host" reads as host "user" on port 0.
        int32 userInfoEnd = std.text.lastIndexOf(authority, "@");
        if (userInfoEnd >= 0) {
            authority = std.text.substring(
                authority, userInfoEnd + 1,
                std.text.codePointCount(authority) - (userInfoEnd + 1));
        }

        // An IPv6 literal is bracketed and full of colons, so the port
        // separator is the colon after "]", not the first one in the string.
        int32 hostEnd = 0;
        if (std.text.startsWith(authority, "[")) {
            int32 bracketEnd = std.text.indexOf(authority, "]");
            if (bracketEnd < 0) {
                throw new Error(format("unterminated IPv6 host in URL: {}", rawUrl));
            }
            uri.host = std.text.substring(authority, 0, bracketEnd + 1);
            hostEnd = bracketEnd + 1;
        } else {
            int32 portSep = std.text.indexOf(authority, ":");
            hostEnd = portSep >= 0 ? portSep : std.text.codePointCount(authority);
            uri.host = std.text.substring(authority, 0, hostEnd);
        }

        int32 authorityLength = std.text.codePointCount(authority);
        if (hostEnd < authorityLength) {
            string separator = std.text.substring(authority, hostEnd, 1);
            if (separator != ":") {
                throw new Error(format("unexpected text after host in URL: {}", rawUrl));
            }
            string portText = std.text.substring(
                authority, hostEnd + 1, authorityLength - (hostEnd + 1));
            if (portText != "") {
                uri.port = std.text.parseInt(portText);
            }
        } else {
            uri.port = defaultPortFor(uri.scheme);
        }

        return uri;
    }

    int32 hexDigitUpper(int32 value) {
        return value < 10 ? 48 + value : 55 + value;
    }

    bool isUnreserved(int32 byteValue) {
        if (byteValue >= 65 && byteValue <= 90) { return true; }   // A-Z
        if (byteValue >= 97 && byteValue <= 122) { return true; }  // a-z
        if (byteValue >= 48 && byteValue <= 57) { return true; }   // 0-9
        return byteValue == 45 || byteValue == 46 ||               // - .
            byteValue == 95 || byteValue == 126;                   // _ ~
    }

    // RFC 3986 percent-encoding over UTF-8 octets. Encoding a subset would not
    // be a smaller version of this: it would be an encoding whose decode is not
    // its inverse, because "%" itself would survive unescaped.
    string encode(string text) {
        uint8[] bytes = std.encoding.utf8Encode(text);
        std.text.StringBuilder* result = new std.text.StringBuilder();
        int32 index = 0;
        while (index < bytes.length) {
            int32 byteValue = bytes[index] as int32;
            if (isUnreserved(byteValue)) {
                result.appendChar(byteValue);
            } else {
                result.appendChar(37);
                result.appendChar(hexDigitUpper((byteValue >> 4) & 15));
                result.appendChar(hexDigitUpper(byteValue & 15));
            }
            index = index + 1;
        }
        return result.toString();
    }

    string decode(string text) {
        uint8[] bytes = std.encoding.utf8Encode(text);
        int32 length = bytes.length;
        uint8[] decoded = new uint8[length];
        int32 source = 0;
        int32 output = 0;
        while (source < length) {
            int32 byteValue = bytes[source] as int32;
            if (byteValue == 37 && source + 2 < length) {
                int32 high = std.encoding.hexValue(bytes[source + 1] as int32);
                int32 low = std.encoding.hexValue(bytes[source + 2] as int32);
                if (high >= 0 && low >= 0) {
                    decoded[output] = ((high << 4) | low) as uint8;
                    output = output + 1;
                    source = source + 3;
                    continue;
                }
            }
            decoded[output] = byteValue as uint8;
            output = output + 1;
            source = source + 1;
        }

        uint8[] exact = new uint8[output];
        int32 copyIndex = 0;
        while (copyIndex < output) {
            exact[copyIndex] = decoded[copyIndex];
            copyIndex = copyIndex + 1;
        }
        return std.encoding.utf8Decode(exact);
    }
}
