namespace std.collections {
    class VectorIterator<T> {
        private T[] snapshot;
        private int32 length;
        private int32 index;

        public VectorIterator(T[] source, int32 sourceLength) {
            snapshot = copy(source[0:sourceLength]);
            length = sourceLength;
            index = -1;
        }

        public bool next() {
            index = index + 1;
            return index < length;
        }

        public T value {
            get { return snapshot[index]; }
        }
    }

    class VectorBuilder<T> {
        private T[] buffer;
        private int32 _count;
        private int32 _capacity;
        private bool _finished;

        public VectorBuilder(T[] initialSource, int32 initialCount) {
            _count = initialCount;
            _capacity = initialCount > 4 ? initialCount : 4;
            buffer = new T[_capacity];
            int32 i = 0;
            while (i < _count) {
                buffer[i] = initialSource[i];
                i = i + 1;
            }
            _finished = false;
        }

        public int32 count {
            get { return _count; }
        }

        public void add(T element) {
            if (_finished) {
                throw new Error("VectorBuilder already finished");
            }
            if (_count == _capacity) {
                int32 newCap = _capacity * 2;
                T[] newBuf = new T[newCap];
                int32 i = 0;
                while (i < _count) {
                    newBuf[i] = buffer[i];
                    i = i + 1;
                }
                buffer = copy(newBuf);
                _capacity = newCap;
            }
            buffer[_count] = element;
            _count = _count + 1;
        }

        public void setAt(int32 index, T element) {
            if (_finished) {
                throw new Error("VectorBuilder already finished");
            }
            if (index < 0 || index >= _count) {
                throw new Error("Index out of bounds");
            }
            buffer[index] = element;
        }

        public T getAt(int32 index) {
            if (index < 0 || index >= _count) {
                throw new Error("Index out of bounds");
            }
            return buffer[index];
        }

        public void removeAt(int32 index) {
            if (_finished) {
                throw new Error("VectorBuilder already finished");
            }
            if (index < 0 || index >= _count) {
                throw new Error("Index out of bounds");
            }
            int32 i = index;
            while (i < _count - 1) {
                buffer[i] = buffer[i + 1];
                i = i + 1;
            }
            _count = _count - 1;
        }

        public std.collections.Vector<T>* finish() {
            if (_finished) {
                throw new Error("VectorBuilder already finished");
            }
            _finished = true;
            std.collections.Vector<T>* result = new std.collections.Vector<T>();
            int32 i = 0;
            while (i < _count) {
                result.push(buffer[i]);
                i = i + 1;
            }
            return result;
        }
    }

    class Vector<T> {
        private T[] items;
        private int32 _count;
        private int32 _capacity;
        private bool _isShared;

        public Vector() {
            _count = 0;
            _capacity = 4;
            items = new T[4];
            _isShared = false;
        }

        public void ensureUnshared() {
            if (_isShared) {
                items = copy(items);
                _isShared = false;
            }
        }

        public int32 count {
            get { return _count; }
        }

        public int32 capacity {
            get { return _capacity; }
        }

        public bool isEmpty {
            get { return _count == 0; }
        }

        public T first {
            get {
                if (_count == 0) { throw new Error("Vector is empty"); }
                return items[0];
            }
        }

        public T last {
            get {
                if (_count == 0) { throw new Error("Vector is empty"); }
                return items[_count - 1];
            }
        }

        public void push(T element) {
            ensureUnshared();
            if (_count == _capacity) {
                int32 newCap = _capacity * 2;
                T[] newItems = new T[newCap];
                int32 i = 0;
                while (i < _count) {
                    newItems[i] = items[i];
                    i = i + 1;
                }
                items = copy(newItems);
                _capacity = newCap;
            }
            items[_count] = element;
            _count = _count + 1;
        }

        public T pop() {
            if (_count == 0) {
                throw new Error("Vector is empty");
            }
            ensureUnshared();
            _count = _count - 1;
            return items[_count];
        }

        public void clear() {
            ensureUnshared();
            _count = 0;
        }

        public void removeAt(int32 index) {
            if (index < 0 || index >= _count) {
                throw new Error("Index out of bounds");
            }
            ensureUnshared();
            int32 i = index;
            while (i < _count - 1) {
                items[i] = items[i + 1];
                i = i + 1;
            }
            _count = _count - 1;
        }

        public T this[int32 index] {
            get {
                if (index < 0 || index >= _count) {
                    throw new Error("Index out of bounds");
                }
                return items[index];
            }
            set {
                if (index < 0 || index >= _count) {
                    throw new Error("Index out of bounds");
                }
                ensureUnshared();
                items[index] = value;
            }
        }

        public std.collections.VectorIterator<T>* iterate() {
            _isShared = true;
            return new std.collections.VectorIterator<T>(items, _count);
        }

        public std.collections.VectorBuilder<T>* builder() {
            return new std.collections.VectorBuilder<T>(items, _count);
        }

        public T[] toArray() {
            T[] res = new T[_count];
            int32 i = 0;
            while (i < _count) {
                res[i] = items[i];
                i = i + 1;
            }
            T[] rawCopy = copy(res);
            return rawCopy;
        }

        public T[] unsafeCopyRaw() {
            return toArray();
        }
    }
}
