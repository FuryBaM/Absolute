namespace std.collections {
    struct HashKeyValuePair<K, V> {
        public K key;
        public V value;

        // A field store takes what it is given, so what is given must be an
        // owner. A parameter borrows unless the caller says otherwise.
        public void initialize(K entryKey, V entryValue) {
            key = move(entryKey);
            value = move(entryValue);
        }
    }

    class HashMapIterator<K, V> {
        // A snapshot names what the map holds; it does not own it. A pair is a
        // struct, and `sub` weakens a handle rather than a struct -- but the
        // pair is *generic* in its value, so the snapshot is the pair
        // instantiated at the weakened parameter. `MapIterator` says the same
        // thing the same way; this file recorded it as the thing that could
        // not be said.
        private HashKeyValuePair<K, sub V>[] snapshot;
        private int32 index;

        public HashMapIterator(HashKeyValuePair<K, sub V>[] entries) {
            snapshot = copy(entries);
            index = -1;
        }

        public bool next() {
            index = index + 1;
            return index < snapshot.length;
        }

        public HashKeyValuePair<K, sub V> value {
            get { return snapshot[index]; }
        }
    }

    class HashMap<K, V> {
        private K[] keys;
        private V[] values;
        // 0 = empty, 1 = occupied, 2 = removed (tombstone).
        private int32[] states;
        private int32 _count;
        private int32 tombstoneCount;
        private int32 _capacity;
        // The capacity is always a power of two, so a bucket index is the hash
        // masked with capacity - 1. Probing used a remainder for every step,
        // which costs an integer division on the hottest path in the map.
        private int32 _mask;
        private func<int64, K> hashFunction;
        private func<bool, K, K> equalityFunction;

        public HashMap(
            func<int64, K> hash,
            func<bool, K, K> equals
        ) {
            hashFunction = hash;
            equalityFunction = equals;
            allocateTable(8);
            _count = 0;
            tombstoneCount = 0;
        }

        public HashMap(
            func<int64, K> hash,
            func<bool, K, K> equals,
            int32 initialCapacity
        ) {
            if (initialCapacity < 1) {
                throw new Error("HashMap capacity must be positive");
            }
            hashFunction = hash;
            equalityFunction = equals;
            allocateTable(roundUpToPowerOfTwo(initialCapacity < 4 ? 4 : initialCapacity));
            _count = 0;
            tombstoneCount = 0;
        }

        private nothrow int32 roundUpToPowerOfTwo(int32 requested) {
            int32 result = 4;
            while (result < requested) {
                result = result * 2;
            }
            return result;
        }

        private nothrow void allocateTable(int32 newCapacity) {
            _capacity = newCapacity;
            _mask = newCapacity - 1;
            keys = new K[_capacity];
            values = new V[_capacity];
            states = new int32[_capacity];
            int32 index = 0;
            while (index < _capacity) {
                states[index] = 0;
                index = index + 1;
            }
        }

        private void clearStates() {
            int32 index = 0;
            while (index < _capacity) {
                states[index] = 0;
                index = index + 1;
            }
        }

        private int32 bucket(K key) {
            func<int64, K> hash = hashFunction;
            // Masking keeps the low bits, exactly as a remainder by a power of
            // two would, and stays non-negative for a negative hash.
            return (hash(key) & (_mask as int64)) as int32;
        }

        private bool keysEqual(K left, K right) {
            func<bool, K, K> equals = equalityFunction;
            return equals(left, right);
        }

        private int32 findIndex(K key) {
            int32 index = bucket(key);
            // Binding the comparison once per lookup instead of once per probe
            // step: every such binding costs a closure retain and release.
            func<bool, K, K> equals = equalityFunction;
            int32 scanned = 0;
            // The mask keeps every index inside the table, so the probe reads
            // do not need a second bounds check.
            while (scanned <= _mask) {
                int32 state = unsafeArrayGet(states, index);
                if (state == 0) { return -1; }
                if (state == 1 && equals(unsafeArrayGet(keys, index), key)) {
                    return index;
                }
                index = (index + 1) & _mask;
                scanned = scanned + 1;
            }
            return -1;
        }

        private int32 findInsertionIndex(K key) {
            int32 index = bucket(key);
            int32 firstTombstone = -1;
            int32 scanned = 0;
            while (scanned <= _mask) {
                int32 state = unsafeArrayGet(states, index);
                if (state == 0) {
                    return firstTombstone >= 0 ? firstTombstone : index;
                }
                if (state == 2 && firstTombstone < 0) {
                    firstTombstone = index;
                }
                index = (index + 1) & _mask;
                scanned = scanned + 1;
            }
            return firstTombstone;
        }

        private void insertRehashed(K key, V value) {
            int32 index = findInsertionIndex(key);
            unsafeArraySet(keys, index, move(key));
            unsafeArraySet(values, index, move(value));
            states[index] = 1;
            _count = _count + 1;
        }

        // Every live entry is taken out of the old table before the table is
        // replaced, and put into the new one from there. A copy gave the new
        // table and the old one a handle each, and the old one is dropped as
        // this call returns; taking is what leaves exactly one name for each
        // entry at every moment in between. The staging arrays hold them for
        // the length of the call, and what is left in them afterwards -- the
        // tombstones and the empty slots -- holds nothing.
        private void rehash(int32 newCapacity) {
            int32 previousCapacity = _capacity;
            K[] stagedKeys = new K[previousCapacity];
            V[] stagedValues = new V[previousCapacity];
            int32[] stagedStates = new int32[previousCapacity];

            int32 index = 0;
            while (index < previousCapacity) {
                stagedStates[index] = states[index];
                if (states[index] == 1) {
                    unsafeArraySet(stagedKeys, index,
                        unsafeArrayTake(keys, index));
                    unsafeArraySet(stagedValues, index,
                        unsafeArrayTake(values, index));
                }
                index = index + 1;
            }

            allocateTable(newCapacity);
            _count = 0;
            tombstoneCount = 0;

            index = 0;
            while (index < previousCapacity) {
                if (stagedStates[index] == 1) {
                    insertRehashed(unsafeArrayTake(stagedKeys, index),
                        unsafeArrayTake(stagedValues, index));
                }
                index = index + 1;
            }
        }

        private void ensureRoomForNewEntry() {
            // Keep at least 30% empty slots so linear probing remains bounded.
            if ((_count + tombstoneCount + 1) * 10 >= _capacity * 7) {
                rehash(_capacity * 2);
            }
        }

        public int32 count {
            get { return _count; }
        }

        public int32 capacity {
            get { return _capacity; }
        }

        public bool isEmpty {
            get { return _count == 0; }
        }

        public bool containsKey(K key) {
            return findIndex(key) >= 0;
        }

        public void put(K key, V value) {
            // One probe decides both questions. Looking the key up and then
            // probing again for its insertion slot walked the same chain twice
            // for every new key.
            int32 index = bucket(key);
            func<bool, K, K> equals = equalityFunction;
            int32 firstTombstone = -1;
            int32 scanned = 0;
            while (scanned <= _mask) {
                int32 state = unsafeArrayGet(states, index);
                if (state == 0) { break; }
                if (state == 1 && equals(unsafeArrayGet(keys, index), key)) {
                    values[index] = move(value);
                    return;
                }
                if (state == 2 && firstTombstone < 0) {
                    firstTombstone = index;
                }
                index = (index + 1) & _mask;
                scanned = scanned + 1;
            }
            if (firstTombstone >= 0) { index = firstTombstone; }

            // Growing invalidates the slot found above, so probe again only in
            // that case.
            if ((_count + tombstoneCount + 1) * 10 >= _capacity * 7) {
                rehash(_capacity * 2);
                index = findInsertionIndex(key);
            }
            if (states[index] == 2) {
                tombstoneCount = tombstoneCount - 1;
            }
            keys[index] = move(key);
            values[index] = move(value);
            states[index] = 1;
            _count = _count + 1;
        }

        public bool tryAdd(K key, V value) {
            if (containsKey(key)) { return false; }
            put(key, value);
            return true;
        }

        public bool remove(K key) {
            int32 index = findIndex(key);
            if (index < 0) { return false; }
            // The slot becomes a tombstone, and nothing will look at it again,
            // so what it held is given back here. Marking the state and
            // leaving the handle in place is a leak for every entry a program
            // removes.
            unsafeArrayDrop(keys, index, 1);
            unsafeArrayDrop(values, index, 1);
            states[index] = 2;
            _count = _count - 1;
            tombstoneCount = tombstoneCount + 1;
            return true;
        }

        public V this[K key] {
            get {
                int32 index = findIndex(key);
                if (index < 0) { throw new Error("Key not found"); }
                return values[index];
            }
            set {
                put(key, value);
            }
        }

        public void clear() {
            allocateTable(_capacity);
            _count = 0;
            tombstoneCount = 0;
        }

        // A second array over the same values, and only one of the two can
        // own them -- this one does not, which the value half of the pair
        // says. Filled field by field rather than through `initialize`,
        // because initialize *takes* its arguments and this hands over
        // nothing.
        public HashKeyValuePair<K, sub V>[] toArray() {
            HashKeyValuePair<K, sub V>[] result =
                new HashKeyValuePair<K, sub V>[_count];
            int32 sourceIndex = 0;
            int32 resultIndex = 0;
            while (sourceIndex < _capacity) {
                if (states[sourceIndex] == 1) {
                    result[resultIndex].key = keys[sourceIndex];
                    result[resultIndex].value = values[sourceIndex];
                    resultIndex = resultIndex + 1;
                }
                sourceIndex = sourceIndex + 1;
            }
            return result;
        }

        public sub K[] keysToArray() {
            sub K[] result = new K[_count];
            int32 sourceIndex = 0;
            int32 resultIndex = 0;
            while (sourceIndex < _capacity) {
                if (states[sourceIndex] == 1) {
                    result[resultIndex] = keys[sourceIndex];
                    resultIndex = resultIndex + 1;
                }
                sourceIndex = sourceIndex + 1;
            }
            return result;
        }

        public sub V[] valuesToArray() {
            sub V[] result = new V[_count];
            int32 sourceIndex = 0;
            int32 resultIndex = 0;
            while (sourceIndex < _capacity) {
                if (states[sourceIndex] == 1) {
                    result[resultIndex] = values[sourceIndex];
                    resultIndex = resultIndex + 1;
                }
                sourceIndex = sourceIndex + 1;
            }
            return result;
        }

        public HashMapIterator<K, V>* iterate() {
            return new HashMapIterator<K, V>(toArray());
        }
    }

    class HashSet<T> {
        private T[] items;
        private int32[] states;
        private int32 _count;
        private int32 tombstoneCount;
        private int32 _capacity;
        // Power-of-two capacity, so probing masks instead of taking a
        // remainder. See HashMap for the same reasoning.
        private int32 _mask;
        // The hash and the equality callbacks read an element and keep
        // neither, so they are handed borrows. At `T = int32` `sub T` is `T`
        // and a caller writes them exactly as before.
        private func<int64, sub T> hashFunction;
        private func<bool, sub T, sub T> equalityFunction;

        public HashSet(
            func<int64, sub T> hash,
            func<bool, sub T, sub T> equals
        ) {
            hashFunction = hash;
            equalityFunction = equals;
            _capacity = 8;
            _mask = _capacity - 1;
            items = new T[_capacity];
            states = new int32[_capacity];
            int32 index = 0;
            while (index < _capacity) {
                states[index] = 0;
                index = index + 1;
            }
            _count = 0;
            tombstoneCount = 0;
        }

        public HashSet(
            func<int64, sub T> hash,
            func<bool, sub T, sub T> equals,
            int32 initialCapacity
        ) {
            if (initialCapacity < 1) {
                throw new Error("HashSet capacity must be positive");
            }
            hashFunction = hash;
            equalityFunction = equals;
            _capacity = 4;
            while (_capacity < initialCapacity) {
                _capacity = _capacity * 2;
            }
            _mask = _capacity - 1;
            items = new T[_capacity];
            states = new int32[_capacity];
            int32 index = 0;
            while (index < _capacity) {
                states[index] = 0;
                index = index + 1;
            }
            _count = 0;
            tombstoneCount = 0;
        }

        private void clearStates() {
            int32 index = 0;
            while (index < _capacity) {
                states[index] = 0;
                index = index + 1;
            }
        }

        private int32 bucket(sub T value) {
            func<int64, sub T> hash = hashFunction;
            return (hash(value) & (_mask as int64)) as int32;
        }

        private bool itemsEqual(sub T left, sub T right) {
            func<bool, sub T, sub T> equals = equalityFunction;
            return equals(left, right);
        }

        private int32 findIndex(sub T value) {
            int32 index = bucket(value);
            func<bool, sub T, sub T> equals = equalityFunction;
            int32 scanned = 0;
            while (scanned <= _mask) {
                int32 state = unsafeArrayGet(states, index);
                if (state == 0) { return -1; }
                if (state == 1 && equals(unsafeArrayGet(items, index), value)) {
                    return index;
                }
                index = (index + 1) & _mask;
                scanned = scanned + 1;
            }
            return -1;
        }

        private int32 findInsertionIndex(sub T value) {
            int32 index = bucket(value);
            int32 firstTombstone = -1;
            int32 scanned = 0;
            while (scanned <= _mask) {
                int32 state = unsafeArrayGet(states, index);
                if (state == 0) {
                    return firstTombstone >= 0 ? firstTombstone : index;
                }
                if (state == 2 && firstTombstone < 0) {
                    firstTombstone = index;
                }
                index = (index + 1) & _mask;
                scanned = scanned + 1;
            }
            return firstTombstone;
        }

        private void insertRehashed(T value) {
            int32 index = findInsertionIndex(value);
            unsafeArraySet(items, index, move(value));
            states[index] = 1;
            _count = _count + 1;
        }

        // The same staging the map's rehash uses, and for the same reason.
        private void rehash(int32 newCapacity) {
            int32 previousCapacity = _capacity;
            T[] stagedItems = new T[previousCapacity];
            int32[] stagedStates = new int32[previousCapacity];

            int32 index = 0;
            while (index < previousCapacity) {
                stagedStates[index] = states[index];
                if (states[index] == 1) {
                    unsafeArraySet(stagedItems, index,
                        unsafeArrayTake(items, index));
                }
                index = index + 1;
            }

            _capacity = newCapacity;
            _mask = _capacity - 1;
            items = new T[_capacity];
            states = new int32[_capacity];
            clearStates();
            _count = 0;
            tombstoneCount = 0;

            index = 0;
            while (index < previousCapacity) {
                if (stagedStates[index] == 1) {
                    insertRehashed(unsafeArrayTake(stagedItems, index));
                }
                index = index + 1;
            }
        }

        private void ensureRoomForNewEntry() {
            if ((_count + tombstoneCount + 1) * 10 >= _capacity * 7) {
                rehash(_capacity * 2);
            }
        }

        public int32 count {
            get { return _count; }
        }

        public int32 capacity {
            get { return _capacity; }
        }

        public bool isEmpty {
            get { return _count == 0; }
        }

        // A membership test compares and keeps nothing, so it borrows what it
        // is handed rather than taking it.
        public bool contains(sub T value) {
            return findIndex(value) >= 0;
        }

        // A duplicate is refused without the set taking anything: nothing was
        // moved out of `value`, so the caller's value is released by the
        // statement that made it.
        public bool add(T value) {
            if (contains(value)) { return false; }
            ensureRoomForNewEntry();
            int32 index = findInsertionIndex(value);
            if (states[index] == 2) {
                tombstoneCount = tombstoneCount - 1;
            }
            unsafeArraySet(items, index, move(value));
            states[index] = 1;
            _count = _count + 1;
            return true;
        }

        public bool remove(sub T value) {
            int32 index = findIndex(value);
            if (index < 0) { return false; }
            // The slot becomes a tombstone, and nothing will look at it again,
            // so what it held is given back here.
            unsafeArrayDrop(items, index, 1);
            states[index] = 2;
            _count = _count - 1;
            tombstoneCount = tombstoneCount + 1;
            return true;
        }

        public void clear() {
            items = new T[_capacity];
            states = new int32[_capacity];
            clearStates();
            _count = 0;
            tombstoneCount = 0;
        }

        // A second array over the same items, and only one of the two can own
        // them -- this one does not.
        public sub T[] toArray() {
            sub T[] result = new T[_count];
            int32 sourceIndex = 0;
            int32 resultIndex = 0;
            while (sourceIndex < _capacity) {
                if (states[sourceIndex] == 1) {
                    result[resultIndex] = items[sourceIndex];
                    resultIndex = resultIndex + 1;
                }
                sourceIndex = sourceIndex + 1;
            }
            return result;
        }
    }
}
