namespace std.collections {
    class DequeIterator<T> {
        // The same thing VectorIterator says: a snapshot is a second array
        // over elements the deque still holds, and only one of the two can own
        // them. At `T = Node*` this is `sub Node*[]` and releasing the iterator
        // releases nothing; at `T = int32` the qualifier is not there at all,
        // because a value with no object has no lifetime to weaken.
        private sub T[] snapshot;
        private int32 index;

        public DequeIterator(sub T[] source) {
            snapshot = copy(source);
            index = -1;
        }

        public bool next() {
            index = index + 1;
            return index < snapshot.length;
        }

        public sub T value {
            get { return snapshot[index]; }
        }
    }

    class Deque<T> {
        private T[] items;
        private int32 head;
        private int32 _count;
        private int32 _capacity;

        public Deque(int32 initialCapacity = 8) {
            if (initialCapacity < 1) {
                throw new Error("Deque capacity must be positive");
            }
            _capacity = initialCapacity;
            items = new T[_capacity];
            head = 0;
            _count = 0;
        }

        private void grow() {
            int32 newCapacity = _capacity * 2;
            T[] next = new T[newCapacity];
            int32 index = 0;
            while (index < _count) {
                // A take rather than a read: the element is leaving the old
                // storage, which is dropped on the next line. Reading it would
                // leave two slots holding one object and the drop would
                // release what the new storage now owns.
                unsafeArraySet(next, index,
                    unsafeArrayTake(items, (head + index) % _capacity));
                index = index + 1;
            }
            items = move(next);
            _capacity = newCapacity;
            head = 0;
        }

        public int32 count {
            get { return _count; }
        }

        public int32 capacity {
            get { return _capacity; }
        }

        public bool isEmpty {
            get { return _count == 0; }
        }

        // Reading an end is not the deque giving it up, so what comes back is
        // the weaker relation to the same object. At `T = int32` the qualifier
        // is not there at all.
        public sub T front {
            get {
                if (_count == 0) { throw new Error("Deque is empty"); }
                return unsafeArrayGet(items, head);
            }
        }

        public sub T back {
            get {
                if (_count == 0) { throw new Error("Deque is empty"); }
                return unsafeArrayGet(items, (head + _count - 1) % _capacity);
            }
        }

        public void pushFront(T value) {
            if (_count == _capacity) { grow(); }
            head = (head + _capacity - 1) % _capacity;
            unsafeArraySet(items, head, move(value));
            _count = _count + 1;
        }

        public void pushBack(T value) {
            if (_count == _capacity) { grow(); }
            int32 index = (head + _count) % _capacity;
            unsafeArraySet(items, index, move(value));
            _count = _count + 1;
        }

        public T popFront() {
            if (_count == 0) { throw new Error("Deque is empty"); }
            // A take rather than a read: the element is leaving, so the slot
            // stops holding it. A read would leave the deque owning what the
            // caller now has, in a slot the deque still drops.
            T result = unsafeArrayTake(items, head);
            head = (head + 1) % _capacity;
            _count = _count - 1;
            if (_count == 0) { head = 0; }
            return result;
        }

        public T popBack() {
            if (_count == 0) { throw new Error("Deque is empty"); }
            int32 index = (head + _count - 1) % _capacity;
            T result = unsafeArrayTake(items, index);
            _count = _count - 1;
            if (_count == 0) { head = 0; }
            return result;
        }

        public void clear() {
            // Whatever the elements were holding is released here. The live
            // range is circular, so it is one run or two; for an element that
            // owns nothing this is not a loop, it is nothing.
            int32 firstRun = _capacity - head;
            if (firstRun > _count) { firstRun = _count; }
            unsafeArrayDrop(items, head, firstRun);
            unsafeArrayDrop(items, 0, _count - firstRun);
            head = 0;
            _count = 0;
        }

        // A search compares; it does not take the element it is given, so
        // it asks for the weaker relation. At `T = int32` the qualifier is
        // not there at all, and an owner still converts to a subscriber.
        public bool contains(sub T target) {
            int32 index = 0;
            while (index < _count) {
                if (unsafeArrayGet(items, (head + index) % _capacity) == target) {
                    return true;
                }
                index = index + 1;
            }
            return false;
        }

        // Written the way Vector's indexer is: one type for both accessors,
        // so the setter is given an element rather than a name for one, and
        // the store releases what the slot held.
        public T this[int32 index] {
            get {
                if (index < 0 || index >= _count) {
                    throw new Error("Deque index out of bounds");
                }
                return unsafeArrayGet(items, (head + index) % _capacity);
            }
            set {
                if (index < 0 || index >= _count) {
                    throw new Error("Deque index out of bounds");
                }
                unsafeArraySet(items, (head + index) % _capacity, move(value));
            }
        }

        // A second array over the same elements, and only one of the two can
        // own them -- this one does not. At `T = int32` this is the ordinary
        // `int32[]` copy it has always been.
        public sub T[] toArray() {
            sub T[] result = new T[_count];
            int32 index = 0;
            while (index < _count) {
                result[index] = unsafeArrayGet(items, (head + index) % _capacity);
                index = index + 1;
            }
            return result;
        }

        public DequeIterator<T>* iterate() {
            return new DequeIterator<T>(toArray());
        }
    }

    class Queue<T> {
        private Deque<T>* storage;

        public Queue(int32 initialCapacity = 8) {
            storage = new Deque<T>(initialCapacity);
        }

        public int32 count {
            get { return storage.count; }
        }

        public bool isEmpty {
            get { return storage.isEmpty; }
        }

        public sub T front {
            get { return storage.front; }
        }

        public void enqueue(T value) {
            // The element is being handed on, not named again: a wrapper that
            // takes an owner and passes it by name keeps the ownership its
            // caller gave it and the deque never gets one.
            storage.pushBack(move(value));
        }

        public T dequeue() {
            return storage.popFront();
        }

        public void clear() {
            storage.clear();
        }

        public sub T[] toArray() {
            return storage.toArray();
        }
    }

    class Stack<T> {
        private Deque<T>* storage;

        public Stack(int32 initialCapacity = 8) {
            storage = new Deque<T>(initialCapacity);
        }

        public int32 count {
            get { return storage.count; }
        }

        public bool isEmpty {
            get { return storage.isEmpty; }
        }

        public sub T top {
            get { return storage.back; }
        }

        public void push(T value) {
            storage.pushBack(move(value));
        }

        public T pop() {
            return storage.popBack();
        }

        public void clear() {
            storage.clear();
        }

        public sub T[] toArray() {
            sub T[] source = storage.toArray();
            sub T[] result = new T[source.length];
            int32 index = 0;
            while (index < source.length) {
                result[index] = source[source.length - index - 1];
                index = index + 1;
            }
            return result;
        }
    }
}
