namespace std.collections {
    class SetIterator<T> {
        private T[] snapshot;
        private int32 length;
        private int32 index;

        public SetIterator(T[] source, int32 sourceLength) {
            snapshot = copy(source[0:sourceLength]);
            length = sourceLength;
            index = -1;
        }

        public bool next() {
            index = index + 1;
            return index < length;
        }

        public T value {
            get { return snapshot[index]; }
        }
    }

    class SetBuilder<T> {
        private T[] buffer;
        private int32 _count;
        private int32 _capacity;
        private bool _finished;

        public SetBuilder(T[] initialSource, int32 initialCount) {
            _count = initialCount;
            _capacity = initialCount > 4 ? initialCount : 4;
            buffer = new T[_capacity];
            int32 i = 0;
            while (i < _count) {
                buffer[i] = initialSource[i];
                i = i + 1;
            }
            _finished = false;
        }

        public int32 count {
            get { return _count; }
        }

        public bool contains(T item) {
            int32 i = 0;
            while (i < _count) {
                if (buffer[i] == item) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        public bool add(T item) {
            if (_finished) {
                throw new Error("SetBuilder already finished");
            }
            if (contains(item)) {
                return false;
            }

            if (_count == _capacity) {
                int32 newCap = _capacity * 2;
                T[] newBuf = new T[newCap];
                int32 j = 0;
                while (j < _count) {
                    newBuf[j] = buffer[j];
                    j = j + 1;
                }
                buffer = copy(newBuf);
                _capacity = newCap;
            }

            buffer[_count] = item;
            _count = _count + 1;
            return true;
        }

        public bool remove(T item) {
            if (_finished) {
                throw new Error("SetBuilder already finished");
            }
            int32 i = 0;
            while (i < _count) {
                if (buffer[i] == item) {
                    int32 j = i;
                    while (j < _count - 1) {
                        buffer[j] = buffer[j + 1];
                        j = j + 1;
                    }
                    _count = _count - 1;
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        public std.collections.Set<T>* finish() {
            if (_finished) {
                throw new Error("SetBuilder already finished");
            }
            _finished = true;
            std.collections.Set<T>* result = new std.collections.Set<T>();
            int32 i = 0;
            while (i < _count) {
                result.add(buffer[i]);
                i = i + 1;
            }
            return result;
        }
    }

    class Set<T> {
        private T[] items;
        private int32 _count;
        private int32 _capacity;
        private bool _isShared;

        public Set() {
            _count = 0;
            _capacity = 4;
            items = new T[4];
            _isShared = false;
        }

        public void ensureUnshared() {
            if (_isShared) {
                items = copy(items);
                _isShared = false;
            }
        }

        public int32 count {
            get { return _count; }
        }

        public int32 capacity {
            get { return _capacity; }
        }

        public bool isEmpty {
            get { return _count == 0; }
        }

        public T itemAt(int32 index) {
            return items[index];
        }

        public bool contains(T item) {
            int32 i = 0;
            while (i < _count) {
                if (items[i] == item) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        public bool add(T item) {
            if (contains(item)) {
                return false;
            }
            ensureUnshared();

            if (_count == _capacity) {
                int32 newCap = _capacity * 2;
                T[] newItems = new T[newCap];
                int32 j = 0;
                while (j < _count) {
                    newItems[j] = items[j];
                    j = j + 1;
                }
                items = copy(newItems);
                _capacity = newCap;
            }

            items[_count] = item;
            _count = _count + 1;
            return true;
        }

        public bool remove(T item) {
            ensureUnshared();
            int32 i = 0;
            while (i < _count) {
                if (items[i] == item) {
                    int32 j = i;
                    while (j < _count - 1) {
                        items[j] = items[j + 1];
                        j = j + 1;
                    }
                    _count = _count - 1;
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        public void clear() {
            ensureUnshared();
            _count = 0;
        }

        public std.collections.SetIterator<T>* iterate() {
            _isShared = true;
            return new std.collections.SetIterator<T>(items, _count);
        }

        public std.collections.SetBuilder<T>* builder() {
            return new std.collections.SetBuilder<T>(items, _count);
        }

        public T[] toArray() {
            T[] res = new T[_count];
            int32 i = 0;
            while (i < _count) {
                res[i] = items[i];
                i = i + 1;
            }
            return res;
        }

        public T[] unsafeCopyRaw() {
            return toArray();
        }
    }
}
