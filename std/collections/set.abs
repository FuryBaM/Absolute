namespace std.collections {
    class SetIterator<T> {
        // The same thing VectorIterator says: a snapshot is a second array
        // over items the set still holds, and only one of the two can own
        // them. At `T = Node*` this is `sub Node*[]` and releasing the
        // iterator releases nothing; at `T = int32` the qualifier is not
        // there at all, because a value with no object has no lifetime to
        // weaken.
        private sub T[] snapshot;
        private int32 length;
        private int32 index;

        public SetIterator(T[] source, int32 sourceLength) {
            snapshot = copy(source[0:sourceLength]);
            length = sourceLength;
            index = -1;
        }

        public bool next() {
            index = index + 1;
            return index < length;
        }

        public sub T value {
            get { return snapshot[index]; }
        }
    }

    class SetBuilder<copyable T> {
        private T[] buffer;
        private int32 _count;
        private int32 _capacity;
        private bool _finished;

        public SetBuilder(T[] initialSource, int32 initialCount) {
            _count = initialCount;
            _capacity = initialCount > 4 ? initialCount : 4;
            buffer = new T[_capacity];
            int32 i = 0;
            while (i < _count) {
                buffer[i] = initialSource[i];
                i = i + 1;
            }
            _finished = false;
        }

        public int32 count {
            get { return _count; }
        }

        public bool contains(T item) {
            int32 i = 0;
            while (i < _count) {
                if (buffer[i] == item) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        public bool add(T item) {
            if (_finished) {
                throw new Error("SetBuilder already finished");
            }
            if (contains(item)) {
                return false;
            }

            if (_count == _capacity) {
                int32 newCap = _capacity * 2;
                T[] newBuf = new T[newCap];
                int32 j = 0;
                while (j < _count) {
                    newBuf[j] = buffer[j];
                    j = j + 1;
                }
                buffer = move(newBuf);
                _capacity = newCap;
            }

            buffer[_count] = item;
            _count = _count + 1;
            return true;
        }

        public bool remove(T item) {
            if (_finished) {
                throw new Error("SetBuilder already finished");
            }
            int32 i = 0;
            while (i < _count) {
                if (buffer[i] == item) {
                    int32 j = i;
                    while (j < _count - 1) {
                        buffer[j] = buffer[j + 1];
                        j = j + 1;
                    }
                    _count = _count - 1;
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        public std.collections.Set<T>* finish() {
            if (_finished) {
                throw new Error("SetBuilder already finished");
            }
            _finished = true;
            std.collections.Set<T>* result = new std.collections.Set<T>();
            int32 i = 0;
            while (i < _count) {
                result.add(buffer[i]);
                i = i + 1;
            }
            return result;
        }
    }

    class Set<T> {
        private T[] items;
        private int32 _count;
        private int32 _capacity;

        public Set() {
            _count = 0;
            _capacity = 4;
            items = new T[4];
        }

        public int32 count {
            get { return _count; }
        }

        public int32 capacity {
            get { return _capacity; }
        }

        public bool isEmpty {
            get { return _count == 0; }
        }

        // Reading an item is not the set giving it up, so what comes back is
        // the weaker relation to the same object.
        public sub T itemAt(int32 index) {
            return unsafeArrayGet(items, index);
        }

        // A membership test compares and keeps nothing, so it borrows what it
        // is handed rather than taking it.
        public bool contains(sub T item) {
            int32 i = 0;
            while (i < _count) {
                if (items[i] == item) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        // A duplicate is refused without the set taking anything: nothing was
        // moved out of `item`, so the caller's value is released by the
        // statement that made it, exactly as an argument that is not kept
        // always is.
        public bool add(T item) {
            if (contains(item)) {
                return false;
            }

            if (_count == _capacity) {
                int32 newCap = _capacity * 2;
                T[] newItems = new T[newCap];
                // A move rather than a loop of element stores: the old
                // storage is dropped on the next line, and for an item that
                // owns something a copy would leave it holding what the new
                // storage now owns.
                unsafeArrayMove(newItems, items, _count);
                items = move(newItems);
                _capacity = newCap;
            }

            unsafeArraySet(items, _count, move(item));
            _count = _count + 1;
            return true;
        }

        // The item being removed is released first; the shift then moves each
        // survivor down by taking it, which leaves the slot it came from
        // empty -- including the last one, so the tail past the new `_count`
        // owns nothing.
        public bool remove(sub T item) {
            int32 i = 0;
            while (i < _count) {
                if (items[i] == item) {
                    unsafeArrayDrop(items, i, 1);
                    int32 j = i;
                    while (j < _count - 1) {
                        unsafeArraySet(items, j, unsafeArrayTake(items, j + 1));
                        j = j + 1;
                    }
                    _count = _count - 1;
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        public void clear() {
            // Whatever the items were holding is released here. For an item
            // that owns nothing this is not a loop, it is nothing.
            unsafeArrayDrop(items, 0, _count);
            _count = 0;
        }

        public std.collections.SetIterator<T>* iterate() {
            return new std.collections.SetIterator<T>(items, _count);
        }

        // A second array over the same items, and only one of the two can own
        // them -- this one does not. At `T = int32` this is the ordinary
        // `int32[]` copy it has always been.
        public sub T[] toArray() {
            sub T[] res = new T[_count];
            int32 i = 0;
            while (i < _count) {
                res[i] = items[i];
                i = i + 1;
            }
            return res;
        }

        public sub T[] unsafeCopyRaw() {
            return toArray();
        }
    }

    // A builder is a staging owner seeded from a live set's storage, so over
    // an item type that owns, its first act is to duplicate what that set
    // still holds. That is what a snapshot means, and an owning item cannot
    // be one -- the same undecided question `VectorBuilder` records.
    //
    // Written as an extension for the same reason: a method's return type is
    // instantiated with the class, so a `Set<Cell*>` could not exist at all
    // while `builder()` was one. It is instantiated where it is called now,
    // so a set of owners is an ordinary set and only a program that asks it
    // for a builder is refused.
    extension std.collections.SetBuilder<T>* builder<T>(
        std.collections.Set<T>* target) {
        return new std.collections.SetBuilder<T>(
            target.unsafeCopyRaw(), target.count);
    }
}
