namespace std.collections {
    class SetIterator<T> {
        private T[] snapshot;
        private int32 length;
        private int32 index;

        public SetIterator(T[] source, int32 sourceLength) {
            snapshot = copy(source[0:sourceLength]);
            length = sourceLength;
            index = -1;
        }

        public bool next() {
            index = index + 1;
            return index < length;
        }

        public T value {
            get { return snapshot[index]; }
        }
    }

    class Set<T> {
        private T[] items;
        private int32 _count;
        private int32 _capacity;
        private bool _isShared;

        public Set() {
            _count = 0;
            _capacity = 4;
            items = new T[4];
            _isShared = false;
        }

        public void ensureUnshared() {
            if (_isShared) {
                items = copy(items);
                _isShared = false;
            }
        }

        public int32 count {
            get { return _count; }
        }

        public int32 capacity {
            get { return _capacity; }
        }

        public T itemAt(int32 index) {
            return items[index];
        }

        public bool contains(T item) {
            int32 i = 0;
            while (i < _count) {
                if (items[i] == item) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        public bool add(T item) {
            if (contains(item)) {
                return false;
            }
            ensureUnshared();

            if (_count == _capacity) {
                int32 newCap = _capacity * 2;
                T[] newItems = new T[newCap];
                int32 j = 0;
                while (j < _count) {
                    newItems[j] = items[j];
                    j = j + 1;
                }
                items = copy(newItems);
                _capacity = newCap;
            }

            items[_count] = item;
            _count = _count + 1;
            return true;
        }

        public bool remove(T item) {
            ensureUnshared();
            int32 i = 0;
            while (i < _count) {
                if (items[i] == item) {
                    int32 j = i;
                    while (j < _count - 1) {
                        items[j] = items[j + 1];
                        j = j + 1;
                    }
                    _count = _count - 1;
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        public void clear() {
            ensureUnshared();
            _count = 0;
        }

        public SetIterator<T>* iterate() {
            _isShared = true;
            return new SetIterator<T>(items, _count);
        }
    }
}
