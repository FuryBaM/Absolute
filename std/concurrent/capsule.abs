extern "C" raw void* absolute_capsule_create(uint64 handle);
extern "C" uint64 absolute_capsule_unwrap(raw void* capsule);
extern "C" void absolute_capsule_destroy(raw void* capsule);

namespace std.concurrent {

    class Capsule {
        private raw void* handle;

        public Capsule(raw void* capsulePtr) {
            handle = capsulePtr;
        }

        public raw void* release() {
            raw void* ptr = handle;
            handle = null;
            return ptr;
        }

        public bool isEmpty() {
            return handle == null;
        }

        // Restores a capsule after a channel rejected a send.
        public void restore(raw void* capsulePtr) {
            if (handle != null || capsulePtr == null) {
                throw new Error("Capsule restore requires an empty capsule and a valid handle");
            }
            handle = capsulePtr;
        }

        public uint64 unwrap() {
            if (handle == null) {
                return 0 as uint64;
            }
            raw void* ptr = handle;
            handle = null;
            return absolute_capsule_unwrap(ptr);
        }

        public void destroy() {
            if (handle != null) {
                absolute_capsule_destroy(handle);
                handle = null;
            }
        }
    }

    // Typed capsule facade used by TransferChannel<T>. Construct it only from
    // seal(move(owner)); the raw Capsule base remains available for FFI code.
    class Transfer<T> : Capsule {
        public Transfer(raw void* capsulePtr) {
            base(capsulePtr);
        }
    }

}
