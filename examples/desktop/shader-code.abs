// absolute.shader with custom GLSL body (`code { ... }`) bound to Desktop.Gpu.
// Esc quit. Requires absolute-desktop + absolute-shader plugins.

@shader.stage(Vertex)
shader Vertex {
    input float3 position;
    input float3 normal;
    input float2 uv;
    uniform float uTime;
    uniform float uScale;
    output float4 clipPosition;
    output float3 vNormal;
    output float2 vUv;
    // Note: Absolute lexer rejects '#'; #version is auto-prepended by the plugin.
    code {
        layout(location=0) in vec3 position;
        layout(location=1) in vec3 normal;
        layout(location=2) in vec2 uv;
        uniform float uTime;
        uniform float uScale;
        out vec3 vNormal;
        out vec2 vUv;
        void main() {
            float c = cos(uTime);
            float s = sin(uTime * 0.7);
            vec3 p = position * uScale;
            float px = p.x * c + p.z * s;
            float pz = -p.x * s + p.z * c;
            p = vec3(px, p.y * (0.85 + 0.15 * cos(uTime * 2.0)), pz);
            float z = p.z + 2.8;
            gl_Position = vec4(p.x / z * 1.7, p.y / z * 1.7, p.z * 0.05, 1.0);
            float nx = normal.x * c + normal.z * s;
            float nz = -normal.x * s + normal.z * c;
            vNormal = normalize(vec3(nx, normal.y, nz));
            vUv = uv;
        }
    }
}

@shader.stage(Fragment)
shader Fragment {
    input float3 vNormal;
    input float2 vUv;
    output float4 FragColor;
    code {
        in vec3 vNormal;
        in vec2 vUv;
        out vec4 FragColor;
        void main() {
            vec3 L = normalize(vec3(0.2, 0.9, 0.3));
            float ndl = max(dot(normalize(vNormal), L), 0.0);
            vec3 cool = vec3(0.2, 0.45, 0.95);
            vec3 warm = vec3(1.0, 0.55, 0.2);
            vec3 base = mix(cool, warm, vUv.x * 0.5 + vUv.y * 0.5);
            FragColor = vec4(base * (0.2 + ndl * 0.95), 1.0);
        }
    }
}

extern "C" string absolute_shader_glsl_Vertex();
extern "C" string absolute_shader_glsl_Fragment();
extern "C" int32 absolute_shader_input_components_Vertex(int32 index);
extern "C" int32 absolute_shader_input_count_Vertex();

int32 main() {
    auto window = new Desktop.Window("Absolute Shader code{}", 800, 500, true);
    if (!window.isOpen()) {
        println("Could not create desktop window");
        return 1;
    }

    auto gpu = new Desktop.Gpu(window, Desktop.Gpu.BackendOpenGL);
    if (!gpu.isValid()) {
        println("OpenGL GPU context failed:");
        println(gpu.lastError());
        window.close();
        return 1;
    }

    auto program = gpu.createShader(absolute_shader_glsl_Vertex(), absolute_shader_glsl_Fragment());
    if (program == null) {
        println("createShader failed:");
        println(gpu.lastError());
        return 1;
    }

    int32 nIn = absolute_shader_input_count_Vertex();
    int32 c0 = nIn > 0 ? absolute_shader_input_components_Vertex(0) : 0;
    int32 c1 = nIn > 1 ? absolute_shader_input_components_Vertex(1) : 0;
    int32 c2 = nIn > 2 ? absolute_shader_input_components_Vertex(2) : 0;
    auto layout = gpu.createLayout3Attr(c0, c1, c2);
    auto pipeline = gpu.createPipeline(program, layout);
    if (layout == null || pipeline == null) {
        println("layout/pipeline failed");
        return 1;
    }

    auto mesh = new Desktop.Mesh();
    bool ok = mesh.loadObj("examples/desktop/assets/cube.obj");
    if (!ok) {
        ok = mesh.loadObj("assets/cube.obj");
    }
    if (!ok) {
        println("Failed to load cube.obj");
        return 1;
    }
    auto vb = gpu.createVertexBufferFromMesh(mesh);
    auto ib = gpu.createIndexBufferFromMesh(mesh);
    if (vb == null || ib == null) {
        println("mesh upload failed");
        return 1;
    }

    int32 indexCount = mesh.indexCount();
    println("shader-code: custom GLSL body bound to Desktop.Gpu");

    while (window.poll()) {
        if (window.keyPressed(Desktop.KeyEscape())) {
            window.close();
        } else {
            float t = Desktop.time() as float;
            gpu.beginFrame();
            gpu.clear(0.04, 0.05, 0.09, 1.0);
            gpu.bind(pipeline);
            gpu.bind(vb);
            gpu.bind(ib);
            gpu.setUniformF("uTime", t);
            gpu.setUniformF("uScale", 1.05);
            gpu.drawIndexed(indexCount);
            gpu.endFrame();
            gpu.present();
        }
    }

    ib.destroy();
    vb.destroy();
    mesh.destroy();
    pipeline.destroy();
    layout.destroy();
    program.destroy();
    gpu.destroy();
    window.close();
    return 0;
}
