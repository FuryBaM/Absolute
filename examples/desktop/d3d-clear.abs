// D3D11 clear/present demo (Windows). Esc quit.
// Desktop.Gpu BackendD3D11: swap chain + RTV clear (full mesh RHI still OpenGL).

int32 main() {
    auto window = new Desktop.Window("Absolute D3D11 Clear", 800, 450, true);
    if (!window.isOpen()) {
        println("Could not create desktop window");
        return 1;
    }

    auto gpu = new Desktop.Gpu(window, Desktop.Gpu.BackendD3D11);
    if (!gpu.isValid()) {
        println("D3D11 GPU context failed:");
        println(gpu.lastError());
        window.close();
        return 1;
    }

    println("Desktop.Gpu backend:");
    println(gpu.backend());

    float t = 0.0;
    while (window.poll()) {
        if (window.keyPressed(Desktop.KeyEscape())) {
            window.close();
        } else {
            double dt = window.deltaTime();
            if (dt <= 0.0) {
                dt = 0.016;
            }
            if (dt > 0.05) {
                dt = 0.05;
            }
            t = t + (dt as float);

            // Pulse between navy and teal (Math plugin).
            float pulse = (Math.sin(t * 1.4) as float) * 0.5 + 0.5;
            float r = 0.04 + pulse * 0.08;
            float g = 0.10 + pulse * 0.35;
            float b = 0.22 + pulse * 0.25;

            gpu.beginFrame();
            gpu.clear(r, g, b, 1.0);
            gpu.endFrame();
            gpu.present();
        }
    }

    gpu.destroy();
    window.close();
    return 0;
}
