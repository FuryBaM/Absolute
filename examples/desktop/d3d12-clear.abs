// D3D12 clear/present demo (Windows). Esc quit.
// Desktop.Gpu BackendD3D12: swap chain + RTV clear (mesh RHI still GL/D3D11).

int32 main() {
    auto window = new Desktop.Window("Absolute D3D12 Clear", 800, 450, true);
    if (!window.isOpen()) {
        println("Could not create desktop window");
        return 1;
    }

    auto gpu = new Desktop.Gpu(window, Desktop.Gpu.BackendD3D12);
    if (!gpu.isValid()) {
        println("D3D12 GPU context failed:");
        println(gpu.lastError());
        window.close();
        return 1;
    }

    println("Desktop.Gpu backend:");
    println(gpu.backend());

    float t = 0.0;
    while (window.poll()) {
        if (window.keyPressed(Desktop.KeyEscape())) {
            window.close();
        } else {
            double dt = window.deltaTime();
            if (dt <= 0.0) { dt = 0.016; }
            if (dt > 0.05) { dt = 0.05; }
            t = t + (dt as float);

            float pulse = (Math.sin(t * 1.2) as float) * 0.5 + 0.5;
            float r = 0.05 + pulse * 0.15;
            float g = 0.08 + pulse * 0.12;
            float b = 0.20 + pulse * 0.40;

            gpu.beginFrame();
            gpu.clear(r, g, b, 1.0);
            gpu.endFrame();
            gpu.present();
        }
    }

    gpu.destroy();
    window.close();
    return 0;
}
