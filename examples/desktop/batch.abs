// Soft sprite batch + atlas demo.
// Esc quit. Arrows / WASD move the ship. Many stars drawn via SpriteBatch.

int32 main() {
    auto window = new Desktop.Window("Absolute Sprite Batch", 720, 400, false);
    if (!window.isOpen()) {
        println("Could not create desktop window");
        return 1;
    }

    auto atlas = new Desktop.Sprite(1, 1);
    if (!atlas.loadBmp("examples/desktop/assets/atlas.bmp")) {
        if (!atlas.loadBmp("assets/atlas.bmp")) {
            println("Failed to load atlas.bmp");
            return 1;
        }
    }
    atlas.colorKey(Desktop.rgb(255, 0, 255));

    auto ship = new Desktop.Sprite(1, 1);
    if (!ship.loadBmp("examples/desktop/assets/ship.bmp")) {
        if (!ship.loadBmp("assets/ship.bmp")) {
            println("Failed to load ship.bmp");
            return 1;
        }
    }
    ship.colorKey(Desktop.rgb(255, 0, 255));

    auto batch = new Desktop.SpriteBatch();
    auto fixed = new Desktop.FixedStep(60.0);
    double shipX = 320.0;
    double shipY = 180.0;
    double anim = 0.0;
    int32 frame = 0;
    int32 lastQueued = 0;

    while (window.poll()) {
        fixed.add(window.deltaTime());

        while (fixed.shouldUpdate()) {
            double step = fixed.step;
            double velX = 0.0;
            double velY = 0.0;
            if (window.keyDown(Desktop.KeyLeft()) || window.keyDown(Desktop.KeyA())) {
                velX = velX - 240.0;
                frame = 2;
            }
            if (window.keyDown(Desktop.KeyRight()) || window.keyDown(Desktop.KeyD())) {
                velX = velX + 240.0;
                frame = 1;
            }
            if (window.keyDown(Desktop.KeyUp()) || window.keyDown(Desktop.KeyW())) {
                velY = velY - 240.0;
            }
            if (window.keyDown(Desktop.KeyDown()) || window.keyDown(Desktop.KeyS())) {
                velY = velY + 240.0;
            }
            if (velX == 0.0 && velY == 0.0) {
                frame = 0;
            }
            shipX = shipX + velX * step;
            shipY = shipY + velY * step;
            double maxX = (window.width() - ship.width()) as double;
            double maxY = (window.height() - ship.height()) as double;
            if (shipX < 0.0) { shipX = 0.0; }
            if (shipY < 0.0) { shipY = 0.0; }
            if (shipX > maxX) { shipX = maxX; }
            if (shipY > maxY) { shipY = maxY; }
            anim = anim + step;
            fixed.consume();
        }

        if (window.keyPressed(Desktop.KeyEscape())) {
            break;
        } else {
            window.clear(Desktop.rgb(10, 12, 24));

            // One batch for all atlas tiles + ship.
            batch.begin(window, atlas);

            int32 i = 0;
            while (i < 120) {
                int32 sx = (i * 53 + (anim * 45.0) as int32) % window.width();
                int32 sy = 16 + (i * 29) % (window.height() - 32);
                int32 tile = i % 4;
                batch.drawRect(sx, sy, tile * 16, 16, 16, 16);
                i = i + 1;
            }

            // Character frame above the ship (atlas row 0).
            int32 charX = (shipX) as int32 + 8;
            int32 charY = (shipY) as int32 - 28;
            batch.drawRect(charX, charY, frame * 16, 0, 16, 16);

            // Ship is a separate sprite; queued without rebinding atlas.
            batch.drawSprite(ship, (shipX) as int32, (shipY) as int32);

            lastQueued = batch.count();
            batch.end();

            // HUD after batch so text is on top.
            window.drawText(12, 10, "SpriteBatch atlas + ship", Desktop.rgb(220, 230, 255), 2);
            // lastQueued is captured before end() clears the queue (~122: 120 stars + frame + ship).
            if (lastQueued > 0) {
                window.drawText(12, 34, "batch ok (see plugins/desktop README)", Desktop.rgb(140, 160, 200), 1);
            }
            window.drawLine(0, window.height() - 1, window.width(), window.height() - 1,
                Desktop.rgb(40, 50, 80));
            window.present();
        }
    }

    return 0;
}
