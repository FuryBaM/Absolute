// absolute.shader reflection + Desktop.Gpu RHI bind.
// Compiles typed shader stages (GLSL generated by absolute.shader), uploads mesh, draws.
// Requires: absolute-desktop + absolute-shader plugins. Esc quit.

@shader.stage(Vertex)
shader Vertex {
    input float3 position;
    input float3 normal;
    input float2 uv;
    uniform float uTime;
    uniform float uScale;
    output float4 clipPosition;
    output float3 vNormal;
    output float2 vUv;
}

@shader.stage(Fragment)
shader Fragment {
    input float3 vNormal;
    input float2 vUv;
    output float4 FragColor;
}

// GLSL source accessors emitted by absolute.shader into this module.
extern "C" string absolute_shader_glsl_Vertex();
extern "C" string absolute_shader_glsl_Fragment();
extern "C" int32 absolute_shader_input_count_Vertex();
extern "C" int32 absolute_shader_input_components_Vertex(int32 index);
extern "C" int32 absolute_shader_vertex_stride_floats_Vertex();

int32 main() {
    auto window = new Desktop.Window("Absolute Shader RHI", 800, 500, true);
    if (!window.isOpen()) {
        println("Could not create desktop window");
        return 1;
    }

    auto gpu = new Desktop.Gpu(window, Desktop.Gpu.BackendOpenGL);
    if (!gpu.isValid()) {
        println("OpenGL GPU context failed:");
        println(gpu.lastError());
        return 1;
    }

    string vs = absolute_shader_glsl_Vertex();
    string fs = absolute_shader_glsl_Fragment();
    auto program = gpu.createShader(vs, fs);
    if (program == null) {
        println("createShader from absolute.shader GLSL failed:");
        println(gpu.lastError());
        return 1;
    }

    // Build vertex layout from reflection (locations 0..n, sequential floats).
    int32 nIn = absolute_shader_input_count_Vertex();
    int32 c0 = 0;
    int32 c1 = 0;
    int32 c2 = 0;
    if (nIn > 0) {
        c0 = absolute_shader_input_components_Vertex(0);
    }
    if (nIn > 1) {
        c1 = absolute_shader_input_components_Vertex(1);
    }
    if (nIn > 2) {
        c2 = absolute_shader_input_components_Vertex(2);
    }
    auto layout = gpu.createLayout3Attr(c0, c1, c2);
    auto pipeline = gpu.createPipeline(program, layout);
    if (layout == null || pipeline == null) {
        println("layout/pipeline failed:");
        println(gpu.lastError());
        return 1;
    }

    auto mesh = new Desktop.Mesh();
    bool ok = mesh.loadObj("examples/desktop/assets/cube.obj");
    if (!ok) {
        ok = mesh.loadObj("assets/cube.obj");
    }
    if (!ok) {
        println("Failed to load cube.obj");
        return 1;
    }

    auto vb = gpu.createVertexBufferFromMesh(mesh);
    auto ib = gpu.createIndexBufferFromMesh(mesh);
    if (vb == null || ib == null) {
        println("mesh GPU upload failed");
        return 1;
    }

    int32 indexCount = mesh.indexCount();
    println("shader-rhi: bound absolute.shader GLSL to Desktop.Gpu");

    while (window.poll()) {
        if (window.keyPressed(Desktop.KeyEscape())) {
            break;
        } else {
            float t = Desktop.time() as float;
            gpu.beginFrame();
            gpu.clear(0.05, 0.06, 0.10, 1.0);
            gpu.bind(pipeline);
            gpu.bind(vb);
            gpu.bind(ib);
            gpu.setUniformF("uTime", t * 0.8);
            gpu.setUniformF("uScale", 1.0);
            gpu.drawIndexed(indexCount);
            gpu.endFrame();
            gpu.present();
        }
    }

    return 0;
}
