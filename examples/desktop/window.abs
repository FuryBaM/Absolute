int32 main() {
    auto window = new Desktop.Window("Absolute Desktop", 800, 450, true);
    if (!window.isOpen()) {
        println("Could not create desktop window");
        return 1;
    }

    double position = 0.0;
    double direction = 1.0;
    while (window.poll()) {
        if (window.keyPressed(Desktop.KeyEscape)) {
            window.close();
        }
        else {
            double dt = window.deltaTime();
            if (dt <= 0.0) {
                dt = 0.016;
            }
            if (dt > 0.05) {
                dt = 0.05;
            }

            window.clear(Desktop.rgb(18, 22, 32));
            window.fillRect((int32)position, 170, 120, 90, Desktop.rgb(70, 150, 255));
            window.drawLine(0, 0, window.width(), window.height(), Desktop.rgb(35, 45, 60));
            window.fillCircle(window.mouseX(), window.mouseY(), 8, Desktop.rgb(255, 190, 60));
            window.present();

            position = position + direction * 240.0 * dt;
            if (position >= (double)(window.width() - 120)) {
                direction = -1.0;
            }
            if (position <= 0.0) {
                direction = 1.0;
            }
        }
    }
    window.close();
    return 0;
}