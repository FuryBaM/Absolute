// Integration project: a reusable CSV/INI package, consumed as a
// library rather than copied into std.
//
// The compiler still resolves packages into a lockfile without
// compiling their sources, so this program imports the library files
// the same way the other integration tests import std. The .absproj
// lists absolute.serde as a dependency, and the CTest build is of that
// project, so a run that passes also wrote the package into the
// lockfile.
//
// The program is hermetic. It generates a small catalogue, writes
// CSV and INI under the working directory, parses both back, and
// checks the cells against the same formula that produced them.
// Four workers each take a shard id, rebuild their paths, and
// report through a shared integer array: a task cannot carry a
// string. Named tasks, all spawned before the first await.

import "../../../../std/fs.abs";
import "../../../../std/json.abs";
import "../../../../std/string.abs";
import "../../../../std/collections/vector.abs";
import "../../../../absolute.serde/src/csv.abs";
import "../../../../absolute.serde/src/ini.abs";

const int32 SHARD_COUNT = 4;
const int32 ROWS_PER_SHARD = 8;

string workRoot() {
    return "absolute-serde-work";
}

string csvPath(int32 shard) {
    return std.fs.join(workRoot(), format("shard-{}.csv", shard));
}

string iniPath(int32 shard) {
    return std.fs.join(workRoot(), format("shard-{}.ini", shard));
}

int32 recordId(int32 shard, int32 index) {
    return shard * ROWS_PER_SHARD + index;
}

int32 recordAmount(int32 shard, int32 index) {
    return 1000 + shard * 100 + index;
}

string recordName(int32 shard, int32 index) {
    int32 kind = (shard + index) % 4;
    if (kind == 0) {
        return format("plain-{}-{}", shard, index);
    }
    if (kind == 1) {
        return format("has,comma {}-{}", shard, index);
    }
    if (kind == 2) {
        return format("say \"hi\" {}-{}", shard, index);
    }
    return format(" spaced {}-{} ", shard, index);
}

string recordNote(int32 shard, int32 index) {
    return format("note {}-{}", shard, index);
}

void pushFour(
    std.collections.Vector<string>* row,
    string a,
    string b,
    string c,
    string d
) {
    row.push(a);
    row.push(b);
    row.push(c);
    row.push(d);
}

serde.csv.CsvTable* makeShardTable(int32 shard) {
    serde.csv.CsvTable* table = new serde.csv.CsvTable();
    std.collections.Vector<string>* header = new std.collections.Vector<string>();
    pushFour(header, "id", "name", "note", "amount");
    table.addRow(header);
    delete header;

    int32 index = 0;
    while (index < ROWS_PER_SHARD) {
        std.collections.Vector<string>* row = new std.collections.Vector<string>();
        pushFour(
            row,
            format("{}", recordId(shard, index)),
            recordName(shard, index),
            recordNote(shard, index),
            format("{}", recordAmount(shard, index)));
        table.addRow(row);
        delete row;
        index = index + 1;
    }
    return table;
}

serde.ini.IniDocument* makeShardIni(int32 shard) {
    serde.ini.IniDocument* doc = new serde.ini.IniDocument();
    doc.add("meta", "shard", format("{}", shard));
    doc.add("meta", "count", format("{}", ROWS_PER_SHARD));
    int32 index = 0;
    while (index < ROWS_PER_SHARD) {
        string section = format("row-{}", index);
        doc.add(section, "id", format("{}", recordId(shard, index)));
        doc.add(section, "name", recordName(shard, index));
        doc.add(section, "note", recordNote(shard, index));
        doc.add(section, "amount", format("{}", recordAmount(shard, index)));
        index = index + 1;
    }
    return doc;
}

void checkCsvShard(serde.csv.CsvTable* table, int32 shard) {
    assert(table.columns == 4, "csv shard has four columns");
    assert(table.rows == ROWS_PER_SHARD + 1, "csv shard has header plus rows");
    assert(table.cell(0, 0) == "id", "csv header id");
    assert(table.cell(0, 1) == "name", "csv header name");
    assert(table.cell(0, 2) == "note", "csv header note");
    assert(table.cell(0, 3) == "amount", "csv header amount");
    assert(table.columnIndex("name") == 1, "csv columnIndex finds name");
    assert(table.columnIndex("missing") == -1, "csv columnIndex misses");

    int32 index = 0;
    while (index < ROWS_PER_SHARD) {
        int32 row = index + 1;
        assert(table.cell(row, 0) == format("{}", recordId(shard, index)),
            "csv id matches the generator");
        assert(table.cell(row, 1) == recordName(shard, index),
            "csv name matches the generator");
        assert(table.cell(row, 2) == recordNote(shard, index),
            "csv note matches the generator");
        assert(table.cell(row, 3) == format("{}", recordAmount(shard, index)),
            "csv amount matches the generator");
        index = index + 1;
    }
}

void checkIniShard(serde.ini.IniDocument* doc, int32 shard) {
    assert(doc.getValue("meta", "shard", "") == format("{}", shard),
        "ini meta.shard matches");
    assert(doc.getValue("meta", "count", "") == format("{}", ROWS_PER_SHARD),
        "ini meta.count matches");
    int32 index = 0;
    while (index < ROWS_PER_SHARD) {
        string section = format("row-{}", index);
        assert(doc.has(section, "name"), "ini row has name");
        assert(doc.getValue(section, "id", "") == format("{}", recordId(shard, index)),
            "ini id matches the generator");
        assert(doc.getValue(section, "name", "") == recordName(shard, index),
            "ini name matches the generator");
        assert(doc.getValue(section, "note", "") == recordNote(shard, index),
            "ini note matches the generator");
        assert(doc.getValue(section, "amount", "") == format("{}", recordAmount(shard, index)),
            "ini amount matches the generator");
        index = index + 1;
    }
}

async int64 checkShard(int64 shard, int64 resultsAddress) {
    raw int64* results = resultsAddress as raw int64*;
    int32 shardIndex = shard as int32;

    string csvText = std.fs.readText(csvPath(shardIndex));
    serde.csv.CsvTable* table = serde.csv.parse(csvText);
    checkCsvShard(table, shardIndex);

    serde.csv.CsvTable* again = serde.csv.parse(serde.csv.stringify(table));
    checkCsvShard(again, shardIndex);

    string iniText = std.fs.readText(iniPath(shardIndex));
    serde.ini.IniDocument* doc = serde.ini.parse(iniText);
    checkIniShard(doc, shardIndex);

    serde.ini.IniDocument* iniAgain = serde.ini.parse(serde.ini.stringify(doc));
    checkIniShard(iniAgain, shardIndex);

    int32 base = shardIndex * 2;
    *(results + base) = (table.rows) as int64;
    *(results + base + 1) = (doc.count) as int64;

    delete table;
    delete again;
    delete doc;
    delete iniAgain;
    return shard;
}

void checkQuotedRoundtrip() {
    serde.csv.CsvTable* table = new serde.csv.CsvTable();
    std.collections.Vector<string>* header = new std.collections.Vector<string>();
    header.push("id");
    header.push("note");
    table.addRow(header);
    delete header;

    std.collections.Vector<string>* row = new std.collections.Vector<string>();
    row.push("1");
    row.push("line1\nline2, still");
    table.addRow(row);
    delete row;

    string encoded = serde.csv.stringify(table);
    assert(std.text.contains(encoded, "\""), "embedded newline is quoted");
    serde.csv.CsvTable* parsed = serde.csv.parse(encoded);
    assert(parsed.rows == 2, "quoted newline stays one row");
    assert(parsed.cell(1, 1) == "line1\nline2, still",
        "quoted field round-trips a comma and a newline");
    delete parsed;
    delete table;
}

void checkSeparators() {
    serde.csv.CsvTable* table = new serde.csv.CsvTable();
    std.collections.Vector<string>* row = new std.collections.Vector<string>();
    row.push("a");
    row.push("b,c");
    table.addRow(row);
    delete row;

    string semi = serde.csv.stringifyWithSeparator(table, 59);
    serde.csv.CsvTable* fromSemi = serde.csv.parseWithSeparator(semi, 59);
    assert(fromSemi.rows == 1 && fromSemi.columns == 2, "semicolon table shape");
    assert(fromSemi.cell(0, 0) == "a" && fromSemi.cell(0, 1) == "b,c",
        "semicolon round-trip keeps the comma inside the field");
    delete fromSemi;

    string tabs = serde.csv.stringifyWithSeparator(table, 9);
    serde.csv.CsvTable* fromTab = serde.csv.parseWithSeparator(tabs, 9);
    assert(fromTab.cell(0, 1) == "b,c", "tab round-trip");
    delete fromTab;
    delete table;
}

void checkCrlfAndPadding() {
    serde.csv.CsvTable* parsed = serde.csv.parse("a,b\r\n1\r\n2,3");
    assert(parsed.rows == 3, "CR LF rows parse");
    assert(parsed.columns == 2, "first row sets the width");
    assert(parsed.cell(1, 0) == "1" && parsed.cell(1, 1) == "",
        "short row pads");
    assert(parsed.cell(2, 0) == "2" && parsed.cell(2, 1) == "3",
        "full row keeps both fields");
    delete parsed;

    serde.csv.CsvTable* trailing = serde.csv.parse("x,y,\n1,2,3");
    assert(trailing.columns == 3, "trailing comma is an empty field");
    assert(trailing.cell(0, 2) == "" && trailing.cell(1, 2) == "3",
        "three-column catalogue including the empty header field");
    delete trailing;
}

void checkIniQuotesAndDuplicates() {
    serde.ini.IniDocument* doc = serde.ini.parse(
        "; comment\n# also\n[s]\nname =  spaced  \nname=second\nplain=ok\n");
    assert(doc.getValue("s", "plain", "") == "ok", "ini unquoted value");
    assert(doc.getValue("s", "name", "") == "second", "ini duplicate keeps the last");
    assert(doc.getValue("missing", "x", "fallback") == "fallback", "ini fallback");
    delete doc;

    serde.ini.IniDocument* built = new serde.ini.IniDocument();
    built.add("s", "name", " has,comma ");
    built.add("s", "said", "say \"hi\"");
    string text = serde.ini.stringify(built);
    serde.ini.IniDocument* parsed = serde.ini.parse(text);
    assert(parsed.getValue("s", "name", "") == " has,comma ",
        "ini quoted spaces and comma round-trip");
    assert(parsed.getValue("s", "said", "") == "say \"hi\"",
        "ini quoted quote round-trip");
    delete parsed;
    delete built;
}

void checkRejectedInput() {
    bool rejected = false;
    try {
        serde.csv.CsvTable* bad = serde.csv.parse("\"unclosed");
        delete bad;
    } catch (Error* error) {
        rejected = std.text.contains(error.message, "unclosed");
    }
    assert(rejected, "unclosed csv quote is rejected");

    rejected = false;
    try {
        serde.ini.IniDocument* bad = serde.ini.parse("[open\nkey=value");
        delete bad;
    } catch (Error* error) {
        rejected = std.text.contains(error.message, "unclosed");
    }
    assert(rejected, "unclosed ini section is rejected");

    rejected = false;
    try {
        serde.ini.IniDocument* bad = serde.ini.parse("not-a-pair");
        delete bad;
    } catch (Error* error) {
        rejected = std.text.contains(error.message, "key=value");
    }
    assert(rejected, "ini line without equals is rejected");

    rejected = false;
    try {
        serde.csv.CsvTable* bad = serde.csv.parse("a,b\n1,2,3");
        delete bad;
    } catch (Error* error) {
        rejected = std.text.contains(error.message, "more fields");
    }
    assert(rejected, "csv row wider than the first is rejected");
}

void checkJsonAgainstCsv(serde.csv.CsvTable* table, int32 shard) {
    std.json.JsonValue* rows = std.json.createArray();
    int32 index = 0;
    while (index < ROWS_PER_SHARD) {
        std.json.JsonValue* obj = std.json.createObject();
        obj.setNumber("id", recordId(shard, index) as double);
        obj.setString("name", recordName(shard, index));
        obj.setString("note", recordNote(shard, index));
        obj.setNumber("amount", recordAmount(shard, index) as double);
        rows.add(obj);
        index = index + 1;
    }
    string encoded = rows.stringify();
    delete rows;

    std.json.JsonValue* parsed = std.json.parse(encoded);
    assert(parsed.isValid() && parsed.isArray(), "json catalogue parses");
    assert(parsed.size() == ROWS_PER_SHARD, "json catalogue length");
    index = 0;
    while (index < ROWS_PER_SHARD) {
        int32 row = index + 1;
        std.json.JsonValue* obj = parsed.getAt(index);
        std.json.JsonValue* nameField = obj.getProp("name");
        assert(nameField.asString() == table.cell(row, 1),
            "json name agrees with csv");
        std.json.JsonValue* amountField = obj.getProp("amount");
        assert(amountField.asInt() == (std.text.parseInt(table.cell(row, 3)) as int64),
            "json amount agrees with csv");
        delete amountField;
        delete nameField;
        delete obj;
        index = index + 1;
    }
    delete parsed;
}

async int32 main() {
    if (std.fs.exists(workRoot())) {
        int32 shard = 0;
        while (shard < SHARD_COUNT) {
            if (std.fs.exists(csvPath(shard))) {
                std.fs.remove(csvPath(shard));
            }
            if (std.fs.exists(iniPath(shard))) {
                std.fs.remove(iniPath(shard));
            }
            shard = shard + 1;
        }
        std.fs.remove(workRoot());
    }
    std.fs.createDirectories(workRoot());

    int32 shard = 0;
    while (shard < SHARD_COUNT) {
        serde.csv.CsvTable* table = makeShardTable(shard);
        std.fs.writeText(csvPath(shard), serde.csv.stringify(table));
        checkJsonAgainstCsv(table, shard);
        delete table;

        serde.ini.IniDocument* doc = makeShardIni(shard);
        std.fs.writeText(iniPath(shard), serde.ini.stringify(doc));
        delete doc;
        shard = shard + 1;
    }

    checkQuotedRoundtrip();
    checkSeparators();
    checkCrlfAndPadding();
    checkIniQuotesAndDuplicates();
    checkRejectedInput();

    int64[] results = new int64[SHARD_COUNT * 2];
    int32 slot = 0;
    while (slot < SHARD_COUNT * 2) {
        results[slot] = 0;
        slot = slot + 1;
    }
    raw int64* resultsAddress = &results[0];
    int64 address = resultsAddress as int64;

    task<int64> worker0 = spawn checkShard(0 as int64, address);
    task<int64> worker1 = spawn checkShard(1 as int64, address);
    task<int64> worker2 = spawn checkShard(2 as int64, address);
    task<int64> worker3 = spawn checkShard(3 as int64, address);

    int64 seen = await worker0;
    seen = seen + await worker1;
    seen = seen + await worker2;
    seen = seen + await worker3;
    assert(seen == 6, "every worker returned its shard id");

    shard = 0;
    int64 totalRows = 0;
    int64 totalPairs = 0;
    while (shard < SHARD_COUNT) {
        int32 base = shard * 2;
        assert(results[base] == (ROWS_PER_SHARD + 1) as int64,
            "each shard parsed the header and every row");
        assert(results[base + 1] == (2 + ROWS_PER_SHARD * 4) as int64,
            "each shard parsed meta plus four keys per row");
        totalRows = totalRows + results[base];
        totalPairs = totalPairs + results[base + 1];
        shard = shard + 1;
    }
    assert(totalRows == (SHARD_COUNT * (ROWS_PER_SHARD + 1)) as int64,
        "all csv rows were parsed");
    assert(totalPairs == (SHARD_COUNT * (2 + ROWS_PER_SHARD * 4)) as int64,
        "all ini pairs were parsed");

    shard = 0;
    while (shard < SHARD_COUNT) {
        std.fs.remove(csvPath(shard));
        std.fs.remove(iniPath(shard));
        shard = shard + 1;
    }
    std.fs.remove(workRoot());
    assert(!std.fs.exists(workRoot()), "the work tree is removed");

    println(format("serde-stats shards={} csvRows={} iniPairs={}",
        SHARD_COUNT, totalRows, totalPairs));
    println("integration-serde=ok");
    return 0;
}
