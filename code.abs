group GameSettings {
    enum Difficulty { Easy, Medium, Hard }
    enum Mode { SinglePlayer, MultiPlayer }

    group Graphics {
        enum Resolution { Low, Medium, High }
        enum Quality { Low, Medium, High, Ultra }
    }

    group Audio {
        enum Volume { Mute, Low, Medium, High }
        enum Effects { Off, On }
    }
}