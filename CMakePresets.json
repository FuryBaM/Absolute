{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "wsl-release-base",
      "hidden": true,
      "binaryDir": "$env{HOME}/.cache/absolute/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ABSOLUTE_ENABLE_LLVM": "ON",
        "ABSOLUTE_BUILD_EXAMPLE_PLUGINS": "ON",
        "LLVM_DIR": "/usr/lib/llvm-18/lib/cmake/llvm"
      }
    },
    {
      "name": "wsl-release",
      "displayName": "WSL Release (Linux filesystem)",
      "description": "Release build stored under $HOME/.cache instead of /mnt for faster WSL I/O.",
      "inherits": "wsl-release-base",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "wsl-release-ninja",
      "displayName": "WSL Release (Ninja)",
      "description": "Requires ninja in WSL.",
      "inherits": "wsl-release-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "environment": {
        "PATH": "${sourceDir}/.absolute/toolchains/ninja;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.absolute/toolchains/ninja/ninja.exe",
        "ABSOLUTE_BUILD_EXAMPLE_PLUGINS": "ON"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC x64 Release",
      "description": "Ninja + MSVC. Run from an x64 Native Tools shell, or use build-windows.bat (same build dir).",
      "inherits": "windows-msvc-base",
      "binaryDir": "${sourceDir}/.absolute/build/windows-release",
      "cacheVariables": {
        "ABSOLUTE_ENABLE_LLVM": "ON"
      }
    },
    {
      "name": "windows-msvc-frontend",
      "displayName": "Windows MSVC frontend only",
      "description": "Parser, analyzer and DLL plugins without the LLVM SDK. Ninja + MSVC; requires developer shell or build-windows.bat --frontend.",
      "inherits": "windows-msvc-base",
      "binaryDir": "${sourceDir}/.absolute/build/windows-frontend",
      "cacheVariables": {
        "ABSOLUTE_ENABLE_LLVM": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "wsl-release",
      "configurePreset": "wsl-release"
    },
    {
      "name": "wsl-release-ninja",
      "configurePreset": "wsl-release-ninja"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "windows-msvc-frontend",
      "configurePreset": "windows-msvc-frontend"
    }
  ],
  "testPresets": [
    {
      "name": "wsl-release",
      "configurePreset": "wsl-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-release-ninja",
      "configurePreset": "wsl-release-ninja",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-frontend",
      "configurePreset": "windows-msvc-frontend",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
