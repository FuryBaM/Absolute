struct WideValue {
    int64 f0;
    int64 f1;
    int64 f2;
    int64 f3;
    int64 f4;
    int64 f5;
    int64 f6;
    int64 f7;
    int64 f8;
    int64 f9;
    int64 f10;
    int64 f11;
    int64 f12;
    int64 f13;
    int64 f14;
    int64 f15;
}

@noinline
int64 inspect(raw WideValue* value, int64 salt) {
    return (value.f0 * 3 + value.f1 * 5 + value.f2 * 7 + value.f3 * 11 +
        value.f4 * 13 + value.f5 * 17 + value.f6 * 19 + value.f7 * 23 +
        value.f8 * 29 + value.f9 * 31 + value.f10 * 37 + value.f11 * 41 +
        value.f12 * 43 + value.f13 * 47 + value.f14 * 53 + value.f15 * 59 + salt) &
        2147483647;
}

int32 main() {
    WideValue value;
    value.f0 = 1;
    value.f1 = 2;
    value.f2 = 3;
    value.f3 = 4;
    value.f4 = 5;
    value.f5 = 6;
    value.f6 = 7;
    value.f7 = 8;
    value.f8 = 9;
    value.f9 = 10;
    value.f10 = 11;
    value.f11 = 12;
    value.f12 = 13;
    value.f13 = 14;
    value.f14 = 15;
    value.f15 = 16;

    raw WideValue* borrowed = &value;
    int64 checksum = 0;
    int64 iteration = 0;
    while (iteration < 20000000) {
        checksum = (checksum + inspect(borrowed, iteration)) & 2147483647;
        iteration += 1;
    }
    println(checksum);
    return 0;
}
