int32 main() {
    double value = 0.5;
    double sum = 0.0;
    int32 i = 0;
    while (i < 100000000) {
        value = value * 1.000000119 + 0.0000001;
        if (value > 2.0) {
            value = value - 1.5;
        }
        sum += value;
        i += 1;
    }
    int32 checksum = sum as int32;
    println(checksum);
    return 0;
}
