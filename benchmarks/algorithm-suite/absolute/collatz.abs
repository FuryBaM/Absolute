int32 main() {
    int64 totalSteps = 0;
    int32 seed = 1;
    while (seed <= 2000000) {
        int64 value = seed;
        while (value > 1) {
            if (value % 2 == 0) {
                value = value / 2;
            }
            else {
                value = value * 3 + 1;
            }
            totalSteps += 1;
        }
        seed += 1;
    }
    println(totalSteps);
    return 0;
}
