int32 main() {
    int64 checksum = 0;
    int32 i = 1;
    while (i <= 5000000) {
        int32 left = i * 17 + 12345;
        int32 right = i * 31 + 6789;
        while (right != 0) {
            int32 remainder = left % right;
            left = right;
            right = remainder;
        }
        checksum += left;
        i += 1;
    }
    println(checksum);
    return 0;
}
