import "std/collections/vector.abs";

int32 main() {
    Vector<int32>* v = new Vector<int32>();
    int32 N = 1000000;
    int32 i = 0;
    while (i < N) {
        v.push(i * 17 + 3);
        i += 1;
    }
    int64 checksum = 0;
    i = 0;
    while (i < N) {
        checksum += v[i];
        i += 1;
    }
    i = 0;
    while (i < 500000) {
        v.pop();
        i += 1;
    }
    checksum += v.count;
    println(checksum);
    return 0;
}
