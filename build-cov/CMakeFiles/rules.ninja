  command = /usr/bin/cmake -E cmake_ninja_dyndep --tdi=CMakeFiles/absolute-export-consumer.dir/CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
  rspfile_content = $in


